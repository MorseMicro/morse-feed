#!/bin/sh
#
# Copyright (C) 2021-2023 Morse Micro Pty Ltd. All rights reserved.
#
# This script generates the DPP qrcode when the morse chip is inserted.
# The DPP qrcode is a combination of the MAC address and the public key.

DPP_QRCODE_KEY_FILE=/etc/dpp_key.pem
DPP_QRCODE_URI_FILE=/etc/dpp_qrcode_uri.txt
DPP_QRCODE_SVG=/www/dpp_qrcode.svg

if [ "$ACTION" != add ]; then
	exit
fi

if ! readlink -f "/sys/${DEVPATH}/device/driver" | grep -q '/morse' ; then
	exit
fi

persistent_vars_storage() {
	if which persistent_vars_storage.sh > /dev/null; then
		persistent_vars_storage.sh "$@"
	fi
}

# In factory mode the contract manufacturer writes the production
# dpp_priv_key into the factory partition slot. If we let this hotplug
# auto-generate one earlier in the same boot, it would land in uboot env
# and mask the factory-written value forever.
mm_mode=$(persistent_vars_storage READ mm_mode)
if [ "$mm_mode" = "factory" ]; then
	logger -p 4 -t dpp-qrcode-key "mm_mode=factory, skipping DPP key handling"
	exit 0
fi

get_dpp_info_field() {
	local board_name=$(cat /tmp/sysinfo/board_name)
	local sid=$(persistent_vars_storage READ serial)

	DPP_INFO_FIELD=
	case "$board_name" in
		morse,halowlink-apx)
			if [ -z "$sid" ]; then
				logger -p 3 -t dpp-qrcode-key "Unable find sid info field for ${board_name} DPP QR code"
				return 1
			fi

			DPP_INFO_FIELD="I:dtype=11,sid=${sid};"
		;;
	esac

	return 0
}

get_dpp_mac_address() {
	local board_name=$(cat /tmp/sysinfo/board_name)

	case "$board_name" in
		morse,halowlink-apx)
			# For APX devices, we manually override the MAC address of the HaLow netdev
			# (wlan0) via UCI to match the lan2 Ethernet MAC address. For more details,
			# see the comments in the file that implements this UCI override:
			# /rom/etc/uci-defaults/98-modeset-apx.
			#
			# Because this runs from hotplug, there may be races where:
			#
			# 	- Netifd has not yet brought up wlan0 as the primary source of UCI-overridden MAC truth.
			#	- wlan0 has been brought up using the OTP MAC address instead of the UCI-override lan2 version.
			#
			# To defend against each race we short-circuit to using lan2.
			if [ -r /sys/class/net/lan2/address ]; then
				cat /sys/class/net/lan2/address
				return 0
			else
				logger -p 3 -t dpp-qrcode-key "Unable find APX DPP MAC address from lan2"
				return 1
			fi
		;;
		*)
			if [ -r "/sys/${DEVPATH}/macaddress" ]; then
				cat "/sys/${DEVPATH}/macaddress"
				return 0
			else
				logger -p 3 -t dpp-qrcode-key "Unable find a valid MAC address on morse phy"
				return 1
			fi
		;;
	esac
}

if [ ! -e "$DPP_QRCODE_KEY_FILE" ]; then
	dpp_priv_key=$(persistent_vars_storage READ dpp_priv_key)

	if [ -z "$dpp_priv_key" ]; then
		logger -p 4 -t dpp-qrcode-key "Generating new DPP private key as it wasn't found in persistent storage"
		# We strip the BEGIN EC PRIVATE KEY and the newlines since this is how the key
		# is stored in persistent storage.
		dpp_priv_key=$(openssl ecparam -genkey -name prime256v1 -noout -outform PEM \
		               | sed '/^---/d' | tr -d '\n')
		# This may fail (e.g. if no persistent_vars_storage is writable). This is ok until
		# a factory reset, as at least we'll cache the key in $DPP_QRCODE_KEY_FILE
		persistent_vars_storage WRITE dpp_priv_key "$dpp_priv_key"
	fi

	echo "-----BEGIN EC PRIVATE KEY-----" > "$DPP_QRCODE_KEY_FILE"
	echo "$dpp_priv_key"                  >> "$DPP_QRCODE_KEY_FILE"
	echo "-----END EC PRIVATE KEY-----"   >> "$DPP_QRCODE_KEY_FILE"
fi

if ! MACADDRESS=$(get_dpp_mac_address | sed 's/://g'); then
	logger -p 3 -t dpp-qrcode-key "Aborting qrcode generation as no valid MAC address found"
	exit
fi

# Generate the public key string from the private key.
# Unfortunately, there is no way to quiet the 'read EC key' messages without redirecting stderr.
PUBLICKEY=$(openssl ec -in "$DPP_QRCODE_KEY_FILE" -pubout -conv_form compressed -outform PEM \
            2> /dev/null | sed '/^---/d' | tr -d '\n')
if ! get_dpp_info_field; then
	exit
fi

DPP_QRCODE_URI="DPP:V:2;${DPP_INFO_FIELD}M:$MACADDRESS;K:$PUBLICKEY;;"

DPP_QRCODE_SVG_TMP=$(mktemp)
qrencode --inline --8bit --type=SVG --output="$DPP_QRCODE_SVG_TMP" "$DPP_QRCODE_URI"
if ! cmp -s "$DPP_QRCODE_SVG_TMP" "$DPP_QRCODE_SVG"; then
	logger -t dpp-qrcode-key "Updating $DPP_QRCODE_SVG"
	cp "$DPP_QRCODE_SVG_TMP" "$DPP_QRCODE_SVG"
	chmod a+r "$DPP_QRCODE_SVG"
fi
rm "$DPP_QRCODE_SVG_TMP"

echo "$DPP_QRCODE_URI" > "$DPP_QRCODE_URI_FILE"
chmod a+r "$DPP_QRCODE_URI_FILE"
