#!/bin/sh /etc/rc.common

START=95
STOP=20
USE_PROCD=1

CONFIG=morselinkeval
PROG=/usr/sbin/morselinkeval

# Append "<flag> <value>" to the command only when the UCI option is set.
# Anything left unset is handled by the daemon's built-in default, so the
# config file is entirely optional.
append_option() {
	local flag="$1" option="$2" value
	config_get value main "$option"
	[ -n "$value" ] && procd_append_param command "$flag" "$value"
}

# Pick the first enabled wifi-device of type "morse"
find_morse_device() {
    local dev="$1" type disabled
    config_get type "$dev" type
    [ "$type" = "morse" ] || return 0

    config_get disabled "$dev" disabled
    [ "$disabled" = "1" ] && return 0

    # Keep only the first match; config_foreach won't stop early, so guard here
    [ -n "$morse_device" ] && return 0
    morse_device="$dev"
}

# For a given device, detect if both AP and STA ifaces exist
scan_iface() {
    local s="$1" parent="$2" dev mode disabled
    config_get dev "$s" device
    [ "$dev" = "$parent" ] || return 0

    config_get disabled "$s" disabled
    [ "$disabled" = "1" ] && return 0

    config_get mode "$s" mode
    case "$mode" in
        ap)  has_ap=1 ;;
        sta) has_sta=1 ;;
    esac

    if [ "$has_ap" = "1" ] || [ "$has_sta" = "1" ]; then
        found=1
        return 1
    fi
    return 0
}

# Returns 0 if the first enabled morse device has both AP and STA, else 1
have_ap_or_sta_on_morse() {
    found=0
    has_ap=0
    has_sta=0
    morse_device=""

    config_load wireless
    config_foreach find_morse_device wifi-device
    [ -z "$morse_device" ] && return 1

    config_foreach scan_iface wifi-iface "$morse_device"

    [ "$found" = "1" ] && return 0 || return 1
}

start_service() {
    if have_ap_or_sta_on_morse; then
		config_load "$CONFIG"
		procd_open_instance
		procd_set_param command "$PROG"
		append_option -i interval
		append_option -w window
		append_option -t idle_timeout
		append_option -m max_peer_link_sessions
		procd_set_param respawn
		procd_set_param stderr 1
		procd_set_param stdout 1
		procd_close_instance
	fi
}

# Config is read once at launch and passed as arguments, so a config change
# can only take effect by relaunching with the new arguments.
reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG" wireless
}
