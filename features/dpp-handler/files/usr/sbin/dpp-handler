#!/usr/bin/ucode
/* DPP handling (push button, and results).
 *
 * This hooks into hostapd/wpa_supplicant via ubus to:
 *  - initiate DPP push buttons
 *  - listen for configuration (and apply when received)
 *  - do push button lockouts to avoid overlap
 *  - reports status via LED
 *  - if no HaLow iface, attempt PB on 2.4 (and then configure HaLow)
 *
 * The two trickiest parts are how it provides custom configuration
 * (via DPP's EXTRA_CONF_NAMESPACE) and then handles this if it receives it
 * (i.e. the same code is handling both sides of the interaction),
 * and that if it attempts to do a PB on 2.4 it will shut down existing
 * interfaces and bring up a temporary interface.
 *
 * Both sides of the config interaction (i.e. generation and application)
 * are in wizard.uc. The LED interactions are in leds.uc. These are
 * tested separately.
 *
 * Note that we don't expect wpa_supplicant to do _any_ of the processing;
 * it's entirely our responsibility to set the uci configuration based
 * on the dpp config (available via subscribing to the appropriate ubus object).
 *
 * Future work:
 *  - report current status (and last status) via ubus
 *  - consider pushing some/all lockout logic into hostapd
 *    (in particular, this will help us not start interactions which are certain
 *    to cause session-overlaps)
 *  - handle DPP qrcode submission (i.e. remove dppd)
 *
 * How a PB interaction works, roughly:
 *
 *   - user initiates on both sides (via ubus call dpp_push_button or similar)
 *   - on the AP side, we provide a custom command to dpp_push_button
 *     which contains extra configuration in com.morsemicro.wizard, and
 *     (if possible) kick off interaction on both 2.4/S1G
 *   - on the STA side, if S1G is available we use that, but if it's not
 *     we temporarily bring down any active non-S1G ifaces and
 *     create a 2.4 STA iface to do DPP on.
 *   - DPP happens (on other 2.4 or S1G)
 *   - while it's happening, any other attempt to call dpp_push_button
 *     is blocked (see dpp_pb.timer) to avoid overlap.
 *   - if it fails, we flash - either for 5s or the lockout time,
 *     depending on whether we think we started the interaction properly.
 *	 - if it succeeds, then on the STA side we look for the extra configuration,
 *     and if present use that to configure S1G (EVEN IF IT CAME OVER 2.4).
 *     If it's not present and we used 2.4 we fail (since we only have a temp iface).
 *     If it's not present and we used S1G, then just change the current iface.
 *   - LEDs are reset and and 2.4 ifaces are restored; user should see
 *     HaLow LED go on (if device has one).
 */
"use strict";

import * as uloop from "uloop";
import { connect } from  "ubus";
import { cursor } from "uci";
import * as fs from "fs";

import {
	apply_config, generate_dpp_command, has_custom_target
} from "dpp.wizard";
import {
	set_dpp_started_led, set_dpp_failed_led, restore_dpp_led, force_ifaces_for_phy
} from "dpp.leds";

const ubus = connect();

const DEBUG = false;

// After starting a PB interaction, set a long timeout in case we don't
// see a PB_RESULT or similar (usually a DPP-PB interaction will timeout after
// 100 seconds).
const FAIL_AFTER_SECS = 105;

// Currently, hostapd has a 120s session overlap detection timeout
// (AFAIK this is not according to spec - it should be 110s before push button).
// To avoid overlapping with ourselves, we keep the failure state going
// for 120s.
const FINISH_AFTER_SECS = 120;

// Seconds to wait for a temporary iface to appear and initiate a PB.
const WAIT_FOR_PB_SECS = 5;

// How long to show failed LED if we need to signal failure but don't actually
// need to lockout.
const FAIL_SIGNAL_SECS = 5;

const TEMP_IFNAME = 'dpp_sta';
const TEMP_WPA_SUPPLICANT_CONF = "/var/run/wpa_supplicant-dpp.conf";


/**
 * Show message if DEBUG is on.
 *
 * @param {string} msg - message to print to stdout.
 */
function debug(...msg) {
	if (DEBUG) {
		print(...msg, "\n");
	}
}


/**
 * Extract the peer MAC address from a DPP URI string.
 *
 * The DPP URI format is: DPP:[<field>;]M:<mac_no_colons>;K:<pubkey>;;
 * The M: field is the enrollee MAC address without colons.
 *
 * @param {string} qrcode - DPP URI string.
 * @returns {string|null} - MAC address in aa:bb:cc:dd:ee:ff form, or null if not found.
 */
function get_peer_mac_from_qrcode(qrcode) {
	const m = match(qrcode, /M:([0-9a-fA-F]{12})/);
	if (!m) {
		return null;
	}
	// Insert colons: aabbccddeeff -> aa:bb:cc:dd:ee:ff
	const hex = lc(m[1]);
	return join(":", [
		substr(hex, 0, 2), substr(hex, 2, 2), substr(hex, 4, 2),
		substr(hex, 6, 2), substr(hex, 8, 2), substr(hex, 10, 2),
	]);
}


/**
 * Get section which created ifname (is there a cleaner way?).
 */
function get_ifname_section(ifname, wireless_status) {
	for (let radio in values(wireless_status)) {
		for (let iface in (radio["interfaces"] ?? [])) {
			if (iface.ifname === ifname) {
				return iface.section;
			}
		}
	}

	return null;
}


/**
 * Find all morse ifnames.
 */
function find_morse_ifnames() {
	const ifnames = [];

	for (let ifname in fs.lsdir('/sys/class/net')) {
		const driver = fs.basename(fs.readlink(`/sys/class/net/${ifname}/device/driver`));
		if (match(driver, /^morse/)) {
			push(ifnames, ifname);
		}
	}

	return ifnames;
}


/**
 * Commit current uci configuration, and notice.
 *
 * @param {uci.cursor} uci - UCI cursor object.
 * @returns {boolean} - True on success.
 */
function commit_config(uci) {
	const config_files = keys(uci.changes());

	if (length(config_files) !== 0 && !uci.commit()) {
		warn("Failed to commit changed config.\n");
		return false;
	}

	// Tell procd about the changes, as /bin/reload_config does.
	let success = true;
	for (let cf in config_files) {
		ubus.call("service", "event", { type: "config.change", data: { package: cf } });
		if (ubus.error()) {
			warn("Failed to signal config change:", ubus.error(), "\n");
			success = false;
		}
	}

	return success;
}


/**
 * Brings up temporary STA interface for DPP PB exchange.
 *
 * This tries to avoid netifd entirely by talking directly to
 * hostapd/wpa_supplicant; the user must run ubus network.wireless reconf
 * to restore the previous state.
 * It will only work on 'normal' devices (i.e. 2.4/5), not morse devices,
 * at it relies on using ubus to configure a daemonised hostapd/wpa_supplicant.
 *
 * @param {string} wifi_device - Name of wireless device section.
 * @returns {object|boolean} - Temp iface object or false on failure.
 */
function start_temp_iface(section) {
	const phyname = ubus.call("iwinfo", "phyname", {section})?.phyname;

	if (!phyname) {
		warn(`Unable to find PHY to create temporary iface for ${section}.\n`);
		return false;
	}

	force_ifaces_for_phy(phyname);

	fs.writefile(TEMP_WPA_SUPPLICANT_CONF, 'dpp_config_processing=0\n');

	// Remove any existing ifaces, as they may interfere with DPP.
	ubus.call("hostapd", "config_set", { phy: phyname });

	// This also removes any existing ifaces.
	// We can defer, because we'll pick up the event from the iface creation.
	ubus.defer("wpa_supplicant", "config_set", {
		phy: phyname,
		config: [{
			ctrl: "/var/run/wpa_supplicant",
			iface: TEMP_IFNAME,
			mode: "sta",
			config: TEMP_WPA_SUPPLICANT_CONF,
			powersave: false
		}],
	});

	return true;
}


/**
 * Find ifname associated with wpad ubus_obj.
 *
 * @param ubus_obj - ubus object of interest (e.g. hostapd.wlan0)
 */
function find_ifname(ubus_obj) {
	const ubus_obj_split = split(ubus_obj, ".");

	if (!(ubus_obj_split[0] in ["wpa_supplicant", "hostapd"]) || !ubus_obj_split[1]) {
		return;
	}
	return ubus_obj_split[1];
}


// dpp_pb is the current PB interaction; it will block other interactions.
let dpp_pb = null;

// wpad_objects has all the WpadObject objects, mapped by ifname.
const wpad_objects = {};


/**
 * DPPPB prototype (i.e. class).
 *
 * In general, only one active of these should exist at a time
 * (stored in dpp_pb), but note that multiple PBs can be started
 * on this object as for an AP, we may want to PB on more than
 * one iface. It is assumed, however, that all these PBs start
 * at the same time, and the failure/success of the first one
 * to report is largely counted as finishing the DPP interaction.
 */
const DPPPB = {
	new: function () {
		return proto({
			timer: null,
			ifnames: [],
			waiting_for_temp_iface: false,
			conf: null,
		}, this);
	},

	cleanup: function () {
		if ((TEMP_IFNAME in this.ifnames) || this.waiting_for_temp_iface) {
			ubus.defer("network.wireless", "reconf");
		}
	},

	set_timer: function (timer) {
		if (this.timer) {
			// If we don't cancel the timer, we'll likely leak memory
			// if the timer's callback contains a reference to
			// something interesting.
			this.timer.cancel();
		}
		this.timer = timer;
	},

	start_temp_iface: function (section) {
		// This will automatically trigger a PB once the iface exists
		// (see register_wpad_objects()).
		debug(`Triggering temporary iface start on ${section}.`);
		if (!start_temp_iface(section)) {
			return false;
		}

		const that = this;
		this.waiting_for_temp_iface = true;
		this.set_timer(uloop.timer(WAIT_FOR_PB_SECS * 1000, () => {
			that.failed();
		}));

		return true;
	},

	restore_leds: function () {
		for (let ifname in this.ifnames) {
			debug("Restoring LED for ", ifname, "\n");
			restore_dpp_led(ifname);
		}
	},

	start: function (ubus_obj, options) {
		print("Starting PB on ", ubus_obj, "\n");
		ubus.call(ubus_obj, "dpp_push_button", options);
		if (ubus.error()) {
			warn(`Unable to start DPP PB interaction on ${ubus_obj}: ${ubus.error()}\n`);
			return false;
		}

		if (!this.timer || this.waiting_for_temp_iface) {
			// We might be starting multiple interactions. Only set a timer
			// for the first; they should be starting at the same time.
			const that = this;
			this.set_timer(uloop.timer(FAIL_AFTER_SECS * 1000, () => {
				that.failed();
			}));

			// Do this regardless of whether this targets TEMP_IFNAME,
			// since it implies we have a success (and can ignore any subsequent
			// temporary fails). In practice, if we're using a TEMP_IFNAME, we only
			// have one PB anyway though.
			this.waiting_for_temp_iface = false;
		}

		const ifname = find_ifname(ubus_obj);
		assert(ifname, `Attempted to target invalid ubus_obj: ${ubus_obj}`);
		set_dpp_started_led(ifname);
		push(this.ifnames, ifname);
		return true;
	},

	/**
	 * Failed configuration after a successful PB.
	 *
	 * This should disable the lockout.
	 */
	failed_config: function (ubus_obj) {
		this.set_timer(null);
		this.failed(ubus_obj);
	},

	/**
	 * Fail PB interaction, either on ubus_obj or all (if no ubus_obj)
	 *
	 * If timer, consider the interaction properly started, so
	 * lockout the user for FINISH_AFTER_SECS to avoid overlap.
	 *
	 * This can be called multiple times, allowing us to simultaneously-ish
	 * time-out and flash any active LEDs for failure, and extend the
	 * FINISH_AFTER_SECS timeout based on the last failure.
	 */
	failed: function (ubus_obj) {
		if (ubus_obj) {
			const ifname = find_ifname(ubus_obj);
			assert(ifname, `Attempted to target invalid ubus_obj: ${ubus_obj}`);
			set_dpp_failed_led(ifname);
		} else {
			if (length(this.ifnames) === 0) {
				// Report failure on any morse ifnames we can find.
				// This happens in early failure when we can't start dpp
				// pb on any ifnames.
				this.ifnames = find_morse_ifnames();
			}

			for (let ifname in this.ifnames) {
				set_dpp_failed_led(ifname);
			}
		}

		const that = this;
		if (this.timer) {
			// This implies we've started the PB, so need to lockout
			// the user for longer to avoid session-overlap.
			this.set_timer(uloop.timer(FINISH_AFTER_SECS * 1000, () => {
				that.set_timer(null);
				dpp_pb = null;
				that.restore_leds();
			}));
		} else {
			let temp_timer;
			temp_timer = uloop.timer(FAIL_SIGNAL_SECS * 1000, () => {
				// Only set "done" if another interaction hasn't started.
				if (dpp_pb === that) {
					that.restore_leds();
					dpp_pb = null;
				}
				temp_timer.cancel();
			});
		}

		this.cleanup();
	},

	success: function () {
		this.set_timer(null);

		if (dpp_pb == this) {
			dpp_pb = null;
		}

		this.restore_leds();
		this.cleanup();
	},

	get_lockout_secs: function () {
		return this.timer ? (this.timer.remaining() + 999) / 1000 : 0;
	},
};


/**
 * DPPQR prototype (i.e. class).
 *
 * Handles a DPP QR code interaction on a single interface.
 * One DPPQR object is created per (ifname, qrcode, peer_mac) tuple.
 */
const DPPQR = {
	new: function (ifname, mode, peer_mac, sessions) {
		return proto({
			ifname,
			mode,
			peer_mac,
			sessions,
			bootstrap_id: null,
			timer: null,
		}, this);
	},

	cleanup: function () {
		debug(`DPPQR cleanup on ${this.ifname} peer=${this.peer_mac} bootstrap_id=${this.bootstrap_id}`);
		if (this.timer) {
			this.timer.cancel();
			this.timer = null;
		}
		if (this.bootstrap_id !== null) {
			ubus.defer(`hostapd.${this.ifname}`, "dpp_bootstrap_remove",
				   { id: `${this.bootstrap_id}` });
			this.bootstrap_id = null;
		}
		delete this.sessions[this.peer_mac];
	},

	restore_leds: function () {
		// Not planned yet
		return;
	},

	/**
	 * Ensure a DPP configurator is ready on this iface (Master mode only).
	 *
	 * Gets or creates a configurator key, generates the basic DPP config
	 * (without custom fields), and sets the configurator params on hostapd.
	 *
	 * @param {string} ubus_obj - Target ubus object.
	 * @returns {object} - { status: "success" } or { status: "failed", error_code }.
	 */
	ensure_configurator: function (ubus_obj) {
		let configurator_id;

		const configurator = ubus.call(ubus_obj, "dpp_configurator_get_key");
		if (configurator?.id) {
			configurator_id = `${configurator.id}`;
			debug(`DPPQR reusing existing configurator id=${configurator_id} on ${this.ifname}`);
		} else {
			const add = ubus.call(ubus_obj, "dpp_configurator_add");
			if (!add?.id) {
				warn(`dpp_configurator_add failed on ${this.ifname}: ${ubus.error()}\n`);
				return { status: "failed", error_code: "hostapd_error" };
			}
			configurator_id = `${add.id}`;
			print(`DPPQR created configurator id=${configurator_id} on ${this.ifname}\n`);
		}

		const uci = cursor();
		const wireless_status = ubus.call("network.wireless", "status");
		const section = wireless_status ? get_ifname_section(this.ifname, wireless_status) : null;
		if (!section) {
			warn(`DPPQR ensure_configurator: no section for ${this.ifname}\n`);
			return { status: "failed", error_code: "no_available_mode" };
		}

		const dpp_command = generate_dpp_command(uci, section, true);
		if (!dpp_command) {
			warn(`DPPQR ensure_configurator: generate_dpp_command returned null for ${section}\n`);
			return { status: "failed", error_code: "bad_argument" };
		}

		const command = `${dpp_command} configurator=${configurator_id}`;
		debug(`DPPQR set_dpp_configurator_params on ${this.ifname}: ${command}`);
		ubus.call(ubus_obj, "set_dpp_configurator_params", { "dpp_conf" : command });
		if (ubus.error()) {
			warn(`set_dpp_configurator_params failed on ${this.ifname}: ${ubus.error()}\n`);
			return { status: "failed", error_code: "hostapd_error" };
		}

		return { status: "success" };
	},

	/**
	 * Configurator (AP) side: submit the QR URI to hostapd to get a bootstrap id.
	 *
	 * @param {string} ubus_obj - Target ubus object (e.g. "hostapd.wlan0").
	 * @param {object} options - { uri, expiry }.
	 * @returns {boolean} - True on success.
	 */
	start_configurator: function (ubus_obj, options) {
		const configurator = this.ensure_configurator(ubus_obj);
		if (configurator.status === "failed") {
			return false;
		}

		const result = ubus.call(ubus_obj, "dpp_qr_code", { uri: options.uri });
		if (!result?.id) {
			warn(`Unable to start DPP QR code interaction on ${this.ifname}: ${ubus.error()}\n`);
			return false;
		}
		this.bootstrap_id = result.id;
		debug(`DPPQR bootstrap_id=${this.bootstrap_id} registered on ${this.ifname}`);

		const that = this;
		const expiry_ms = ((options?.expiry > 0) ? options.expiry : FINISH_AFTER_SECS) * 1000;
		debug(`DPPQR expiry armed for ${expiry_ms}ms on ${this.ifname} peer=${this.peer_mac}`);
		this.timer = uloop.timer(expiry_ms, () => {
			warn(`DPPQR session expired on ${that.ifname} peer=${that.peer_mac}\n`);
			that.failed();
		});

		return true;

	},

	/**
	 * Enrollee (STA) side: session is already in progress in wpa_supplicant;
	 * we just track it for subsequent conf_received/result events.
	 *
	 * @param {string} ubus_obj - Target ubus object (e.g. "wpa_supplicant.wlan0").
	 * @param {object} options - { expiry }.
	 * @returns {boolean} - True on success.
	 */
	start_enrollee: function (ubus_obj, options) {
		// Nothing to do on the supplicant; the auth has already begun.
		return true;
	},

	/**
	 * Start the QR code interaction.
	 *
	 * Signature aligned with DPPPB.start(ubus_obj, options). Dispatches to
	 * start_configurator (AP) or start_enrollee (STA) based on this.mode,
	 * then arms the session expiry timer.
	 *
	 * @param {string} ubus_obj - Target ubus object (e.g. "hostapd.wlan0").
	 * @param {object} options - { expiry } (enrollee) or { uri, expiry } (configurator).
	 *                           expiry is the session validity in seconds.
	 */
	start: function (ubus_obj, options) {
		print(`Starting QR code DPP on ${this.ifname} (mode=${this.mode}) peer=${this.peer_mac}\n`);

		const ok = (this.mode === "Master")
			? this.start_configurator(ubus_obj, options)
			: this.start_enrollee(ubus_obj, options);

		return ok;
	},

	/**
	 * Fail the QR interaction. ubus_obj is accepted for signature parity with
	 * DPPPB.failed but is unused (DPPQR is single-iface).
	 */
	failed: function (ubus_obj) {
		print(`DPPQR failed on ${this.ifname} peer=${this.peer_mac}\n`);
		this.cleanup();
	},

	/**
	 * Failed configuration after a successful QR interaction.
	 *
	 * Mirrors DPPPB.failed_config for symmetry; treated the same as failed()
	 * since QR has no session-overlap lockout.
	 */
	failed_config: function (ubus_obj) {
		print(`DPPQR failed_config on ${this.ifname} peer=${this.peer_mac}\n`);
		this.failed(ubus_obj);
	},

	success: function () {
		print(`DPPQR success on ${this.ifname} peer=${this.peer_mac}\n`);
		this.cleanup();
	},
};


/**
 * WpadObject prototype (i.e. class).
 *
 * One WpadObject is created for each iface you want to react to
 * (via a ubus_obj like wpa_supplicant.wlan0).
 */
const WpadObject = {
	/**
	 * Construct a WpadObject.
	 */
	new: function (ubus_obj, ifname, hwmode, mode) {
		// QR sessions are tracked on HaLow AP (configurator) and STA (enrollee) ifaces.
		const qr_capable = (hwmode === "ah" && mode in ["Master", "Client"]);
		return proto({
			ubus_obj, ifname, hwmode, mode,
			dpp_qr_sessions: qr_capable ? {} : null,
		}, this);
	},

	create: function (ubus_obj) {
		const ifname = find_ifname(ubus_obj);
		if (!ifname) {
			return null;
		}

		const iwinfo_info = ubus.call("iwinfo", "info", {device: ifname});
		if (!iwinfo_info) {
			warn(`Unable to call iwinfo for ${ifname}; ignoring.\n`);
			return null;
		}

		const hwmode = iwinfo_info.hwmode;
		const mode = iwinfo_info.mode;

		if ((hwmode === "ah" && mode in ["Master", "Client"])
				|| mode === "Master"
				|| (mode === "Client" && ifname === TEMP_IFNAME)) {
			return this.new(ubus_obj, ifname, hwmode, mode);
		} else {
			warn(`No valid DPP action for ${ifname}; ignoring.\n`);
			return null;
		}
	},

	is_dpp_pb: function () {
		return dpp_pb && (this.ifname in dpp_pb.ifnames);
	},

	find_qr_session: function (peer_mac) {
		if (!this.dpp_qr_sessions) {
			return null;
		}
		if (peer_mac) {
			return this.dpp_qr_sessions[peer_mac];
		}
		// Supplicant QR events don't carry peer_mac; return the first active session.
		const macs = keys(this.dpp_qr_sessions);
		return length(macs) ? this.dpp_qr_sessions[macs[0]] : null;
	},

	/**
	 * Resolve the DPP session for an event flow.
	 *
	 * @param {string} flow - "pb" or "qr".
	 * @param {object} data - Event payload.
	 * @returns {object|null} - Session object (DPPPB or DPPQR), or null.
	 */
	resolve_session: function (flow, data) {
		if (flow === "pb") {
			return this.is_dpp_pb() ? dpp_pb : null;
		}
		if (flow === "qr") {
			return this.find_qr_session(data.peer_mac);
		}
		return null;
	},

	notify: function (type, data) {
		debug("Received DPP event: ", type, " ", data);

		// Event format: dpp.<flow>.<action>  (e.g. dpp.pb.result, dpp.qr.conf_failed).
		const parts = split(type, ".");
		const flow = parts[1];
		const action = parts[2];

		if (flow === "qr" && action === "result" && data.status === "started") {
			if (this.mode === "Client") {
				// Supplicant emits a result "started" on enrollee side when auth starts.
				// Create a session to track subsequent conf_received/result.
				print(`DPP QR session "started" on ${this.ifname} with peer=${data.peer_mac}\n`);
				this.start_qr_session(data.peer_mac, {});
			}
			// On the configurator (Master) side, "started" is informational
			// (auth begun); the terminal result will arrive later. Ignore it
			// so we don't tear down the bootstrap mid-handshake.
			return;
		}

		const session = this.resolve_session(flow, data);
		if (!session) {
			warn(`No active DPP session for ${type} on ${this.ifname} (peer=${data.peer_mac ?? "n/a"})\n`);
			return;
		}

		if (action === "conf_failed") {
			// Sometimes, there's no *.result after a conf failure,
			// so we need to trigger this immediately.
			// This seems to happen if you try to DPP back to yourself with the same creds.
			print(`Received ${type} on ${this.ifname} (peer=${data.peer_mac ?? "n/a"})\n`);
			this.failed(session);
		} else if (action === "conf_received") {
			debug(`Received ${type} on ${this.ifname} peer=${data.peer_mac ?? "n/a"}`);
			session.conf = data.conf;
		} else if (action === "result") {
			print(`Received ${type} status=${data.status} on ${this.ifname} (peer=${data.peer_mac ?? "n/a"})\n`);
			if (data.status === "success") {
				this.success(session);
			} 
			else {
				warn(`DPP failed on ${this.ifname} due to ${data.status}\n`);
				this.failed(session);
			}
		} else {
			warn(`Received unknown DPP event: ${type}\n`);
		}
	},

	/**
	 * Start a DPP QR session on this iface.
	 *
	 * Creates a DPPQR, ensures the configurator is ready (Master only), and
	 * starts the session. The session is inserted into dpp_qr_sessions only
	 * after start() succeeds.
	 *
	 * @param {string} peer_mac - Enrollee MAC (keys the session).
	 * @param {object} options - { uri, expiry } for Master; {} for Client.
	 * @returns {object} - { status: "success" } or { status: "failed", error_code }.
	 */
	start_qr_session: function (peer_mac, options) {
		debug(`start_qr_session on ${this.ifname} peer=${peer_mac} mode=${this.mode}`);

		if (!this.dpp_qr_sessions || !peer_mac) {
			warn(`start_qr_session rejected on ${this.ifname}: iface not QR-capable (mode=${this.mode}) or missing peer_mac (${peer_mac})\n`);
			return { status: "failed", error_code: "bad_argument" };
		}

		if (this.dpp_qr_sessions[peer_mac]) {
			warn(`start_qr_session rejected on ${this.ifname}: peer ${peer_mac} already active\n`);
			return { status: "failed", error_code: "already_active" };
		}

		const session = DPPQR.new(this.ifname, this.mode, peer_mac, this.dpp_qr_sessions);

		if (!session.start(this.ubus_obj, options)) {
			return { status: "failed", error_code: "dpp_failed" };
		}

		this.dpp_qr_sessions[peer_mac] = session;
		print(`QR session started on ${this.ifname} peer=${peer_mac} mode=${this.mode}\n`);
		return { status: "success" };
	},

	cleanup: function () {
		if (this.is_dpp_pb()) {
			dpp_pb.failed(this.ubus_obj);
		}
		if (this.dpp_qr_sessions) {
			for (let session in values(this.dpp_qr_sessions)) {
				session.cleanup();
			}
		}
	},

	failed: function (session) {
		session.conf = null;
		session.failed(this.ubus_obj);
	},

	apply_client_config: function (session) {
		const uci = cursor();

		let section;
		const wireless_status = ubus.call("network.wireless", "status");
		if (wireless_status) {
			section = get_ifname_section(this.ifname, wireless_status);
		}

		debug(sprintf("apply_client_config on %s (section=%s): %.J\n",
		              this.ifname, section, session.conf));

		// apply_config needs section to target the normal conf, but
		// custom conf will apply without section. This would usually
		// happen if it's a temporary interface.
		return apply_config(uci, session.conf, section) && commit_config(uci);
	},

	success: function (session) {
		let config_success = true;
		if (this.mode === "Client") {
			config_success = this.apply_client_config(session);
		}

		if (config_success) {
			session.success();
		} else {
			session.failed_config(this.ubus_obj);
		}
	},
};


/**
 * Ubus handler for triggering DPP PB.
 *
 * If no mode is provided, AP mode is preferred.
 *
 * Will trigger DPP-PB on all APs if any HaLow APs exist.
 * OR, will trigger DPP-PB on a STA if any HaLow STAs exist.
 * OR, will trigger DPP-PB on a temp non-HaLow STA if any non-HaLow _radios_ exist.
 *
 * This enable HaLow configuration over non-HaLow radios.
 *
 * @param {object} req - Ubus request object (mode = sta/ap/undefined).
 * @returns {object} - Result containing lockout info or error.
 */
function push_button(req) {
	gc();
	debug(`Object count: ${gc("count")}`);

	const proposed_mode = req.args.mode;
	const uci = cursor();

	let target_wpad_objs = null;
	let target_devices = null;

	if (proposed_mode && !(proposed_mode in ["ap", "sta"])) {
		return {
			error: `DPP using mode=${proposed_mode} not valid`,
			error_code: "bad_argument",
		}
	}

	const lockout_remaining_secs = dpp_pb ? dpp_pb.get_lockout_secs() : 0;
	if (lockout_remaining_secs) {
		return {
			error: `DPP button already pressed recently. Please wait ${lockout_remaining_secs} more seconds to avoid overlap.`,
			error_code: "lockout",
			lockout_remaining_secs,
		}
	}

	dpp_pb = DPPPB.new();

	const wireless_status = ubus.call("network.wireless", "status");
	if (!wireless_status) {
		warn("Couldn't call network:wireless.status; aborting DPP-PB: ", ubus.error(), "\n");
		dpp_pb.failed();
		return {
			error: 'Failed to call network:wireless.status',
			error_code: "ubus_error",
			lockout_remaining_secs,
		}
	}

	// Trigger on all APs if any HaLow AP
	// (since we use 2.4 to provide HaLow conf only).
	if (proposed_mode === "ap" || !proposed_mode) {
		const ap_wpad_objects = filter(values(wpad_objects), wpad_obj => wpad_obj.mode === "Master");
		if ("ah" in map(ap_wpad_objects, wpad_obj => wpad_obj.hwmode)) {
			target_wpad_objs = ap_wpad_objects;
		}
	}

	if ((proposed_mode === "sta" || !proposed_mode) && !target_wpad_objs) {
		if (uci.get("prplmesh", "config", "enable") === "1") {
			dpp_pb.failed();
			return {
				"error": "DPP pairing when EasyMesh is enabled is only supported on the AP side. Reset your device back to a normal Client/Station to redo pairing.",
				"error_code": "no_available_mode",
				lockout_remaining_secs,
			}
		}

		// Trigger on HaLow STA only if it exists.
		for (let wpad_obj in values(wpad_objects)) {
			if (wpad_obj.mode === "Client" && wpad_obj.hwmode === "ah") {
				target_wpad_objs = [wpad_obj];
				break;
			}
		}

		// Trigger on temporary 2.4 STA if no HaLow STA configured but there
		// is uci configuration for a STA (i.e. it would be nice to configure it).
		// If we don't check whether we have a sane custom target, we may accidentally
		// configure a HaLow AP! The 2.4 STA can be temporary only, as it's just used
		// for transferring the config.
		if (!target_wpad_objs && has_custom_target(uci)) {
			for (let device_name, device in wireless_status) {
				if (device.config.band === "2g") {
					target_devices = [device_name];
					break;
				}
			}
		}
	}

	if (!target_wpad_objs && !target_devices) {
		dpp_pb.failed();
		return {
			"error": "Unable to discover a valid interface to trigger DPP push button on",
			"error_code": "no_available_mode",
			lockout_remaining_secs,
		}
	}

	let some_success = false;
	for (let wpad_obj in target_wpad_objs) {
		const options = {};
		if (wpad_obj.mode === "Master") {
			const section = get_ifname_section(wpad_obj.ifname, wireless_status);
			if (!section) {
				warn(`Unable to start DPP PB interaction on ${wpad_obj.ubus_obj}: no section for ${wpad_obj.ifname}.\n`);
				continue;
			}
			options.command = generate_dpp_command(uci, section, true);
			if (!options.command) {
				warn(`Unable to start DPP PB interaction on ${wpad_obj.ubus_obj}: failed to generate command.\n`);
				continue;
			}
		}

		if (dpp_pb.start(wpad_obj.ubus_obj, options)) {
			some_success = true;
		}
	}

	for (let device_name in target_devices) {
		if (dpp_pb.start_temp_iface(device_name)) {
			some_success = true;
		}
	}

	if (!some_success) {
		dpp_pb.failed();
		return {
			error: "Unable to trigger dpp push button",
			error_code: "dpp_failed",
			lockout_remaining_secs: 0,
		};
	}

	return {
		lockout_remaining_secs: dpp_pb.get_lockout_secs(),
	};
}

/**
 * Ubus handler for registering a DPP QR code and starting a configurator session.
 *
 * Finds the first HaLow AP interface and delegates to its start_qr_session.
 *
 * @param {object} req - Ubus request object.
 *   uri {string}     - DPP URI from the enrollee's QR code (mandatory).
 *   expiry {number}  - Optional session expiry in seconds (default: FINISH_AFTER_SECS).
 * @returns {object} - { status: "success", peer_mac } or { status: "failed", error_code }.
 */
function register_qrcode(req) {
	const uri = req.args.uri;
	const expiry = req.args.expiry;

	print(`ubus register_qrcode called (expiry=${expiry ?? "default"})\n`);

	if (!uri) {
		warn("register_qrcode rejected: missing uri\n");
		return { status: "failed", error_code: "bad_argument" };
	}

	const peer_mac = get_peer_mac_from_qrcode(uri);
	if (!peer_mac) {
		warn(`register_qrcode rejected: could not parse peer_mac from uri\n`);
		return { status: "failed", error_code: "bad_argument" };
	}
	debug(`register_qrcode parsed peer_mac=${peer_mac} from uri`);

	// Find the first HaLow AP wpad_object.
	let target_wpad_obj = null;
	for (let wpad_obj in values(wpad_objects)) {
		if (wpad_obj.hwmode === "ah" && wpad_obj.mode === "Master") {
			target_wpad_obj = wpad_obj;
			break;
		}
	}

	if (!target_wpad_obj) {
		warn("register_qrcode rejected: no HaLow AP interface available\n");
		return { status: "failed", error_code: "no_available_mode" };
	}
	debug(`register_qrcode using ifname=${target_wpad_obj.ifname}`);

	const result = target_wpad_obj.start_qr_session(peer_mac, { uri, expiry });
	if (result.status === "failed") {
		warn(`register_qrcode failed: error_code=${result.error_code}\n`);
		return result;
	}
	return { status: "success"};
}

/**
 * Keeps track of all wpad_objects for ifaces that can be targeted.
 *
 * This not only finds all current hostapd/wpa_supplicants, but
 * also any future ones that appear (i.e. due to reconfigurations).
 */
function register_wpad_objects() {
	for (let ubus_obj in ubus.list()) {
		const wpad_object = WpadObject.create(ubus_obj);
		if (wpad_object) {
			wpad_objects[wpad_object.ifname] = wpad_object;
		}
	}

	ubus.listener("ubus.object.*", (type, data) => {
		debug(`${type}: ${data.path}`);
		const ifname = find_ifname(data.path);
		if (!ifname) {
			return;
		}

		switch (type) {
		case "ubus.object.add":
			assert(!wpad_objects[ifname], `Trying to add WpadObject when one already exists: ${ifname}`);
			const wpad_object = WpadObject.create(data.path);
			if (wpad_object) {
				wpad_objects[ifname] = wpad_object;
				if (ifname === TEMP_IFNAME && dpp_pb) {
					if (!dpp_pb.start(wpad_object.ubus_obj)) {
						dpp_pb.failed(wpad_object.ubus_obj);
					}
				}
			}
			break;
		case "ubus.object.remove":
			if (wpad_objects[ifname]) {
				wpad_objects[ifname].cleanup();
				delete wpad_objects[ifname];
			}
			break;
		}

		gc();
		debug(`Object count: ${gc("count")}`);
	});
}


/**
 * Attempt to prevent the LEDs from ending in a bad state.
 */
function terminate(signo) {
	if (dpp_pb) {
		dpp_pb.restore_leds();
	}

	for (let wpad_obj in values(wpad_objects)) {
		if (wpad_obj.dpp_qr_sessions) {
			for (let session in values(wpad_obj.dpp_qr_sessions)) {
				session.restore_leds();
			}
		}
	}

	// In OpenWrt 23.05.6, calling exit(0) here breaks libucode (GPF), but we really
	// want to terminate the program.
	assert(false, "Ignore this exception; it's a workaround for a broken exit() in signal handlers");
}


let ubus_methods = {
	push_button: {
		call: push_button,
		args: {
			mode: "",
			ubus_rpc_session: "",
		},
	},

	get_lockout_secs: {
		call: () => ({ lockout_remaining_secs: dpp_pb ? dpp_pb.get_lockout_secs() : 0 }),
		args: {
			ubus_rpc_session: "",
		},
	},

	register_qrcode: {
		call: register_qrcode,
		args: {
			uri: "",
			expiry: 0,
			ubus_rpc_session: "",
		},
	},
};


if (DEBUG) {
	ubus_methods = {
		...ubus_methods,

		// Testing helpers - these allow us to easily interact with components of the
		// system, but are not public interfaces.
		_start_temp_iface: {
			call: (req) => start_temp_iface(req.args.section),
			args: {
				section: "",
			},
		},

		_generate_dpp_command: {
			call: (req) => ({"command": generate_dpp_command(cursor(), req.args.section, req.args.include_custom ?? true)}),
			args: {
				section: "",
				include_custom: true,
			},
		},
	};
}


function dispatch_dpp_event(type, data) {
	const wpad_obj = wpad_objects[data.ifname];
	if (!wpad_obj) {
		warn(`Not listening to ${data.ifname}, so ignoring ${type} (internal error).\n`);
		return;
	}
	wpad_obj.notify(type, data);
}


uloop.init();
ubus.publish("dpp", ubus_methods);
register_wpad_objects();
ubus.listener("dpp.*", dispatch_dpp_event);
signal('int', terminate);
signal('term', terminate);
uloop.run();
