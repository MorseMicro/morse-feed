<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<title>{{_("HaLow Extender Configuration Complete")}}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="stylesheet" type="text/css" href="/style.css" />
</head>
<body>
	<div class="content">

	<h2>{{_("HaLow Extender Configuration Complete")}}</h2>

	<p>
		{{_("You have now configured the SSID/password for this device.")}}

	<p>
		<strong>{{_("WARNING")}}</strong>: {{_("your device will no longer \
		have a static IP, and it will attempt to connect to the SSID/password \
		you have specified. You may need to disconnect and reconnect your \
		laptop/mobile to acquire a new IP.")}}

	<p>
		{{_("If your HaLow light does not come on, reset your device, \
		reload this page, and sure you have entered the correct credentials.")}}

	</div>
</body>
</html>
