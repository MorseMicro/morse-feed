From c5f6abf7d4ac5cda71c6a75345118dcc61f410c1 Mon Sep 17 00:00:00 2001
From: Sagar Bussa <sagar.bussa@morsemicro.com>
Date: Thu, 27 Nov 2025 03:27:23 +0000
Subject: [PATCH] SW-17895 HL2 connection fails on overlapped channels in JP & AU (pull request #1921)

Issue: After successfully completing the DPP exchange and obtaining the
mesh profile, the HL2 extender is unable to detect or connect to the
Mesh Gate on overlapped channel in the JP and AU regulatory domains.
Reason: During the DPP session on the AP interface, the Mesh Gateâ€™s
mesh interface stops beaconing.

Fix: Extend the Morse driver to handle the beacon re-enable
notification (BSS_CHANGED_BEACON_ENABLED) from mac80211. When beaconing
is re-enabled, the driver must restart beacon transmissions on the mesh
interface. This ensures that the HL2 extender can once again detect
the Mesh Gate and successfully establish a mesh connection.


Approved-by: Pradeep Reddy
Approved-by: Ria Polly Thomas


Approved-by: Pradeep Reddy
---
 mac.c | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/mac.c b/mac.c
index e6ec6dee..fd808494 100644
--- a/mac.c
+++ b/mac.c
@@ -4108,16 +4108,22 @@ morse_mac_ops_bss_info_changed(struct ieee80211_hw *hw,
 		}
 		mors_vif->beaconing_enabled = true;
 
-		/* Handle only stop mesh. Start mesh will be handled, when supplicant
+		/* Handle only stop and restart mesh. Start mesh will be handled, when supplicant
 		 * configures mesh id and other params.
 		 */
-		if (ieee80211_vif_is_mesh(vif) && !vif->bss_conf.enable_beacon) {
-			int ret = morse_cmd_cfg_mesh_bss(mors_vif, true);
-
-			if (mors_vif->mesh->conf)
-				mors_vif->mesh->conf->is_mesh_active = false;
-			if (ret)
-				MORSE_ERR(mors, "Stop mesh beaconing ret=%d\n", ret);
+		if (ieee80211_vif_is_mesh(vif)) {
+			if (!vif->bss_conf.enable_beacon) {
+				int ret = morse_cmd_cfg_mesh_bss(mors_vif, true);
+
+				if (mors_vif->mesh->conf)
+					mors_vif->mesh->conf->is_mesh_active = false;
+				if (ret)
+					MORSE_ERR(mors, "Stop mesh beaconing ret=%d\n", ret);
+			} else if (mors_vif->mesh->conf && mors_vif->mesh->conf->mesh_id_len) {
+				MORSE_INFO(mors, "Restart mesh beaconing, mesh_id_len=%d\n",
+						 mors_vif->mesh->conf->mesh_id_len);
+				morse_cmd_set_mesh_config(mors_vif, NULL, false);
+			}
 		}
 	}
 
