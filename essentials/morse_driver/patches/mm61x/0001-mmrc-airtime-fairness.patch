From 1149b3805ca170d25f9b5293aa70bca22aa57d2b Mon Sep 17 00:00:00 2001
From: Lachlan Hodges <lachlan.hodges@morsemicro.com>
Date: Wed, 25 Feb 2026 13:50:04 +1100
Subject: [PATCH] TEST: mmrc airtime fairness

---
 mmrc-submodule/src/core/mmrc.c | 12 ++++++++++++
 mmrc-submodule/src/core/mmrc.h |  1 +
 2 files changed, 13 insertions(+)

diff --git a/mmrc-submodule/src/core/mmrc.c b/mmrc-submodule/src/core/mmrc.c
index c5dcf27d8d42..a76793316d0a 100644
--- a/mmrc-submodule/src/core/mmrc.c
+++ b/mmrc-submodule/src/core/mmrc.c
@@ -783,6 +783,18 @@ static u32 calculate_attempt_time(struct mmrc_rate *rate, size_t size)
 	return time;
 }
 
+
+u32 mmrc_calculate_rate_tx_time(struct mmrc_rate *rate, size_t size)
+{
+	u8 i;
+	u64 total_time = 0;
+
+	for (i = 0; i < rate->attempts; i++)
+		total_time += calculate_attempt_time(rate, size);
+
+	return total_time;
+}
+
 /**
  * Calculates the appropriate amount of additional attempts to make based on
  * packet size and theoretical throughput.
diff --git a/mmrc-submodule/src/core/mmrc.h b/mmrc-submodule/src/core/mmrc.h
index 609ce56abf33..5fd24260979d 100644
--- a/mmrc-submodule/src/core/mmrc.h
+++ b/mmrc-submodule/src/core/mmrc.h
@@ -474,5 +474,6 @@ u32 mmrc_calculate_theoretical_throughput(struct mmrc_rate rate);
  */
 
 struct mmrc_rate mmrc_sta_get_best_rate(struct mmrc_table *tb);
+u32 mmrc_calculate_rate_tx_time(struct mmrc_rate *rate, size_t size);
 
 #endif /* _MMRC_H_ */
-- 
2.43.0

