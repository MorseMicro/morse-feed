From e8b25acae3c4cd34213a591dff29e2e981cbe158 Mon Sep 17 00:00:00 2001
From: James Haggerty <james.haggerty@morsemicro.com>
Date: Tue, 12 Aug 2025 10:53:46 +1000
Subject: [PATCH] DPP: add ubus notifications when result happens

This lets userspace react when DPP PB has finished.

---
 src/ap/dpp_hostapd.c            | 37 ++++++++++++++++++++++--------
 src/common/dpp.c                |  3 +++
 src/common/dpp.h                |  1 +
 wpa_supplicant/dpp_supplicant.c | 40 ++++++++++++++++++++++++++-------
 4 files changed, 64 insertions(+), 17 deletions(-)

diff --git a/src/ap/dpp_hostapd.c b/src/ap/dpp_hostapd.c
index 4358761d7..58b162dc4 100644
--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -24,6 +24,7 @@
 #include "wpa_auth.h"
 #include "beacon.h"
 #include "dpp_hostapd.h"
+#include "ubus.h"
 
 #if defined(CONFIG_IEEE80211AH)
 #include "morse.h"
@@ -1385,8 +1386,10 @@ static void hostapd_dpp_gas_resp_cb(void *ctx, const u8 *addr, u8 dialog_token,
 	}
 #endif /* CONFIG_TESTING_OPTIONS */
 fail:
-	if (status != DPP_STATUS_OK)
+	if (status != DPP_STATUS_OK) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_type(hapd, "dpp_conf_failed");
+	}
 #ifdef CONFIG_DPP2
 	if (auth->peer_version >= 2 &&
 	    auth->conf_resp_status == DPP_STATUS_OK) {
@@ -1567,6 +1570,7 @@ static void hostapd_dpp_config_result_wait_timeout(void *eloop_ctx,
 	wpa_printf(MSG_DEBUG,
 		   "DPP: Timeout while waiting for Configuration Result");
 	wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+	hostapd_ubus_notify_type(hapd, "dpp_conf_failed");
 	dpp_auth_deinit(auth);
 	hapd->dpp_auth = NULL;
 }
@@ -1676,20 +1680,25 @@ static void hostapd_dpp_rx_conf_result(struct hostapd_data *hapd, const u8 *src,
 	if (status == DPP_STATUS_OK)
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_SENT
 			"conf_status=%d", auth->conf_resp_status);
-	else
+	else {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_type(hapd, "dpp_conf_failed");
+	}
 	dpp_auth_deinit(auth);
 	hapd->dpp_auth = NULL;
 	eloop_cancel_timeout(hostapd_dpp_config_result_wait_timeout, hapd,
 			     NULL);
 #ifdef CONFIG_DPP3
 	if (!ifaces->dpp_pb_result_indicated && hostapd_dpp_pb_active(hapd)) {
-		if (status == DPP_STATUS_OK)
+		if (status == DPP_STATUS_OK) {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"success");
-		else
+			hostapd_ubus_notify_dpp_pb_result(hapd, "success");
+		} else {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"no-configuration-available");
+			hostapd_ubus_notify_dpp_pb_result(hapd, "no-configuration-available");
+		}
 		ifaces->dpp_pb_result_indicated = true;
 		if (status == DPP_STATUS_OK)
 			hostapd_dpp_remove_pb_hash(hapd);
@@ -2700,6 +2709,7 @@ hostapd_dpp_rx_pb_presence_announcement(struct hostapd_data *hapd,
 				wpa_msg(hapd->msg_ctx, MSG_INFO,
 					DPP_EVENT_PB_RESULT "session-overlap");
 				ifaces->dpp_pb_result_indicated = true;
+				hostapd_ubus_notify_dpp_pb_result(hapd, "session-overlap");
 			}
 			hostapd_dpp_push_button_stop(hapd);
 			return;
@@ -3247,8 +3257,10 @@ hostapd_dpp_gas_req_handler(struct hostapd_data *hapd, const u8 *sa,
 	}
 
 	resp = dpp_conf_req_rx(auth, query, query_len);
-	if (!resp)
+	if (!resp) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_type(hapd, "dpp_conf_failed");
+	}
 	return resp;
 }
 
@@ -3295,18 +3307,23 @@ void hostapd_dpp_gas_status_handler(struct hostapd_data *hapd, int ok)
 	if (ok)
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_SENT
 			"conf_status=%d", auth->conf_resp_status);
-	else
+	else {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		hostapd_ubus_notify_type(hapd, "dpp_conf_failed");
+	}
 	dpp_auth_deinit(hapd->dpp_auth);
 	hapd->dpp_auth = NULL;
 #ifdef CONFIG_DPP3
 	if (!ifaces->dpp_pb_result_indicated && hostapd_dpp_pb_active(hapd)) {
-		if (ok)
+		if (ok) {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"success");
-		else
+			hostapd_ubus_notify_dpp_pb_result(hapd, "success");
+		} else {
 			wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_PB_RESULT
 				"could-not-connect");
+			hostapd_ubus_notify_dpp_pb_result(hapd, "could-not-connect");
+		}
 		ifaces->dpp_pb_result_indicated = true;
 		if (ok)
 			hostapd_dpp_remove_pb_hash(hapd);
@@ -4086,9 +4103,11 @@ void hostapd_dpp_push_button_stop(struct hostapd_data *hapd)
 	eloop_cancel_timeout(hostapd_dpp_push_button_expire, hapd, NULL);
 	if (hostapd_dpp_pb_active(hapd)) {
 		wpa_printf(MSG_DEBUG, "DPP: Stop active push button mode");
-		if (!ifaces->dpp_pb_result_indicated)
+		if (!ifaces->dpp_pb_result_indicated) {
 			wpa_msg(hapd->msg_ctx, MSG_INFO,
 				DPP_EVENT_PB_RESULT "failed");
+			hostapd_ubus_notify_dpp_pb_result(hapd, "failed");
+		}
 	}
 	ifaces->dpp_pb_time.sec = 0;
 	ifaces->dpp_pb_time.usec = 0;
diff --git a/src/common/dpp.c b/src/common/dpp.c
index 3364b4ce4..be1c7ff98 100644
--- a/src/common/dpp.c
+++ b/src/common/dpp.c
@@ -1502,6 +1502,7 @@ void dpp_auth_deinit(struct dpp_authentication *auth)
 		struct dpp_config_obj *conf = &auth->conf_obj[i];
 
 		os_free(conf->connector);
+		os_free(conf->conf_obj);
 		wpabuf_free(conf->c_sign_key);
 		wpabuf_free(conf->certbag);
 		wpabuf_free(conf->certs);
@@ -3297,6 +3298,8 @@ static int dpp_parse_conf_obj(struct dpp_authentication *auth,
 	}
 	conf = &auth->conf_obj[auth->num_conf_obj++];
 
+	conf->conf_obj = os_strdup((const char *) conf_obj);
+
 	if (ssid64) {
 		conf->ssid_len = wpabuf_len(ssid64);
 		os_memcpy(conf->ssid, wpabuf_head(ssid64), conf->ssid_len);
diff --git a/src/common/dpp.h b/src/common/dpp.h
index 237525e9b..354a92863 100644
--- a/src/common/dpp.h
+++ b/src/common/dpp.h
@@ -359,6 +359,7 @@ struct dpp_authentication {
 	int provision_configurator;
 	struct dpp_configurator *conf;
 	struct dpp_config_obj {
+		char *conf_obj; /* raw JSON of config object */
 		char *connector; /* received signedConnector */
 		u8 ssid[SSID_MAX_LEN];
 		u8 ssid_len;
diff --git a/wpa_supplicant/dpp_supplicant.c b/wpa_supplicant/dpp_supplicant.c
index 95248aabb..57fba7b9a 100644
--- a/wpa_supplicant/dpp_supplicant.c
+++ b/wpa_supplicant/dpp_supplicant.c
@@ -31,6 +31,7 @@
 #include "scan.h"
 #include "notify.h"
 #include "dpp_supplicant.h"
+#include "ubus.h"
 
 #ifdef CONFIG_DPP2
 #define DEFAULT_CHIRP_FOREVER_START_DELAY_S     (2)
@@ -1685,6 +1686,8 @@ static int wpas_dpp_handle_config_obj(struct wpa_supplicant *wpa_s,
 				      struct dpp_authentication *auth,
 				      struct dpp_config_obj *conf)
 {
+	wpas_ubus_notify_dpp_conf_received(wpa_s, conf);
+
 	wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_RECEIVED);
 	wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONFOBJ_AKM "%s",
 		dpp_akm_str(conf->akm));
@@ -1804,6 +1807,7 @@ static int wpas_dpp_handle_config_obj(struct wpa_supplicant *wpa_s,
 #ifdef CONFIG_DPP3
 	if (!wpa_s->dpp_pb_result_indicated) {
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT "success");
+		wpas_ubus_notify_dpp_pb_result(wpa_s, "success");
 		wpa_s->dpp_pb_result_indicated = true;
 	}
 
@@ -1974,8 +1978,10 @@ static void wpas_dpp_gas_resp_cb(void *ctx, const u8 *addr, u8 dialog_token,
 	}
 #endif /* CONFIG_TESTING_OPTIONS */
 fail:
-	if (status != DPP_STATUS_OK)
+	if (status != DPP_STATUS_OK) {
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
+	}
 #ifdef CONFIG_DPP2
 	if (auth->peer_version >= 2 &&
 	    auth->conf_resp_status == DPP_STATUS_OK) {
@@ -2021,6 +2027,7 @@ static void wpas_dpp_gas_client_timeout(void *eloop_ctx, void *timeout_ctx)
 
 	wpa_printf(MSG_DEBUG, "DPP: Timeout while waiting for Config Response");
 	wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+	wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
 	dpp_auth_deinit(wpa_s->dpp_auth);
 	wpa_s->dpp_auth = NULL;
 }
@@ -2210,6 +2217,7 @@ static void wpas_dpp_config_result_wait_timeout(void *eloop_ctx,
 	wpa_printf(MSG_DEBUG,
 		   "DPP: Timeout while waiting for Configuration Result");
 	wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+	wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
 	dpp_auth_deinit(auth);
 	wpa_s->dpp_auth = NULL;
 }
@@ -2332,19 +2340,24 @@ static void wpas_dpp_rx_conf_result(struct wpa_supplicant *wpa_s, const u8 *src,
 	if (status == DPP_STATUS_OK)
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_SENT "conf_status=%d",
 			auth->conf_resp_status);
-	else
+	else {
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
+	}
 	dpp_auth_deinit(auth);
 	wpa_s->dpp_auth = NULL;
 	eloop_cancel_timeout(wpas_dpp_config_result_wait_timeout, wpa_s, NULL);
 #ifdef CONFIG_DPP3
 	if (!wpa_s->dpp_pb_result_indicated && wpas_dpp_pb_active(wpa_s)) {
-		if (status == DPP_STATUS_OK)
+		if (status == DPP_STATUS_OK) {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT
 				"success");
-		else
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "success");
+		} else {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT
 				"no-configuration-available");
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "no-configuration-available");
+		}
 		wpa_s->dpp_pb_result_indicated = true;
 		if (status == DPP_STATUS_OK)
 			wpas_dpp_remove_pb_hash(wpa_s);
@@ -3670,6 +3683,7 @@ wpas_dpp_rx_pb_presence_announcement(struct wpa_supplicant *wpa_s,
 			    wpas_dpp_pb_active(wpa_s)) {
 				wpa_msg(wpa_s, MSG_INFO,
 					DPP_EVENT_PB_RESULT "session-overlap");
+				wpas_ubus_notify_dpp_pb_result(wpa_s, "session-overlap");
 				wpa_s->dpp_pb_result_indicated = true;
 			}
 			wpas_dpp_push_button_stop(wpa_s);
@@ -3823,6 +3837,7 @@ skip_hash_check:
 		if (!wpa_s->dpp_pb_result_indicated) {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT
 				"session-overlap");
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "session-overlap");
 			wpa_s->dpp_pb_result_indicated = true;
 		}
 		wpas_dpp_push_button_stop(wpa_s);
@@ -4380,6 +4395,7 @@ wpas_dpp_gas_req_handler(void *ctx, void *resp_ctx, const u8 *sa,
 	auth->conf_resp = resp;
 	if (!resp) {
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
 		dpp_auth_deinit(wpa_s->dpp_auth);
 		wpa_s->dpp_auth = NULL;
 	}
@@ -4447,19 +4463,24 @@ wpas_dpp_gas_status_handler(void *ctx, struct wpabuf *resp, int ok)
 	if (ok)
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_SENT "conf_status=%d",
 			auth->conf_resp_status);
-	else
+	else {
 		wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_CONF_FAILED);
+		wpas_ubus_notify_type(wpa_s, "dpp_conf_failed");
+	}
 	dpp_auth_deinit(wpa_s->dpp_auth);
 	wpa_s->dpp_auth = NULL;
 	wpabuf_free(resp);
 #ifdef CONFIG_DPP3
 	if (!wpa_s->dpp_pb_result_indicated && wpas_dpp_pb_active(wpa_s)) {
-		if (ok)
+		if (ok) {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT
 				"success");
-		else
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "success");
+		} else {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT
 				"could-not-connect");
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "could-not-connect");
+		}
 		wpa_s->dpp_pb_result_indicated = true;
 		if (ok)
 			wpas_dpp_remove_pb_hash(wpa_s);
@@ -6030,6 +6051,7 @@ void wpas_dpp_push_button_stop(struct wpa_supplicant *wpa_s)
 		wpa_s->dpp_pb_bi = NULL;
 		if (!wpa_s->dpp_pb_result_indicated) {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT "failed");
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "failed");
 			wpa_s->dpp_pb_result_indicated = true;
 		}
 	}
@@ -6046,8 +6068,10 @@ void wpas_dpp_push_button_stop(struct wpa_supplicant *wpa_s)
 	eloop_cancel_timeout(wpas_dpp_pb_discovery_t2e, wpa_s, NULL);
 	if (wpas_dpp_pb_active(wpa_s)) {
 		wpa_printf(MSG_DEBUG, "DPP: Stop active push button mode");
-		if (!wpa_s->dpp_pb_result_indicated)
+		if (!wpa_s->dpp_pb_result_indicated) {
 			wpa_msg(wpa_s, MSG_INFO, DPP_EVENT_PB_RESULT "failed");
+			wpas_ubus_notify_dpp_pb_result(wpa_s, "failed");
+		}
 	}
 	wpa_s->dpp_pb_time.sec = 0;
 	wpa_s->dpp_pb_time.usec = 0;
-- 
2.34.1

