diff --git a/src/utils/morse.c b/src/utils/morse.c
index 1b7feecf1..9194ba437 100644
--- a/src/utils/morse.c
+++ b/src/utils/morse.c
@@ -2149,4 +2149,182 @@ int morse_s1g_get_first_center_freq_for_country(char *cc)
 
 	return freq;
 }
+
+int morse_s1g_get_oper_chan_from_ht_vht_ies(char *cc,
+									   struct ieee80211_ht_operation  *ht,
+									   struct ieee80211_vht_operation *vht)
+{
+    int ht_idx = 0;
+    int s1g = -1;
+
+    if (vht) {
+        u8 cw = vht->vht_op_info_chwidth;
+        if (cw == CHANWIDTH_80MHZ || cw == CHANWIDTH_160MHZ) {
+            ht_idx = vht->vht_op_info_chan_center_freq_seg0_idx;
+            if (ht_idx > 0) {
+                s1g = morse_ht_chan_to_s1g_chan(ht_idx);
+                if (s1g > 0)
+                    return s1g;
+            }
+        }
+    }
+
+    if (!ht)
+        return -1;
+
+    ht_idx = ht->primary_chan;
+    if (ht_idx <= 0)
+        return -1;
+
+    /* Country-specific correction (JP) before mapping to S1G */
+    if (cc && os_strncmp(cc, "JP", COUNTRY_CODE_LEN) == 0)
+        ht_idx -= morse_ht_chan_offset_jp(ht_idx, MORSE_INVALID_CHANNEL, 1);
+
+    s1g = morse_ht_chan_to_s1g_chan(ht_idx);
+    if (s1g <= 0)
+        return -1;
+
+    if (ht->ht_param & HT_INFO_HT_PARAM_STA_CHNL_WIDTH) {
+        u8 sec_off = ht->ht_param & HT_INFO_HT_PARAM_SECONDARY_CHNL_OFF_MASK;
+        int sec = morse_cc_get_sec_channel_offset(sec_off, cc);
+        if (sec)
+            s1g += sec;
+    }
+    return s1g;
+}
+
+/* Returns S1G primary 1 MHz channel (may be <=0 if mapping fails). */
+int morse_s1g_get_prim_chane_from_ht_ie(char *cc,
+                                       struct ieee80211_ht_operation *ht_oper)
+{
+    int ht_chan, s1g_prim_1mhz_chan;
+
+    if (!ht_oper)
+        return -1;
+
+    ht_chan = ht_oper->primary_chan;
+
+    if (cc && os_strncmp(cc, "JP", COUNTRY_CODE_LEN) == 0)
+        ht_chan -= morse_ht_chan_offset_jp(ht_chan, MORSE_INVALID_CHANNEL, 1);
+
+    s1g_prim_1mhz_chan = morse_ht_chan_to_s1g_chan(ht_chan);
+    return s1g_prim_1mhz_chan;
+}
+
+int morse_s1g_get_prim_chwidth_from_ht_ies(struct ieee80211_ht_operation *ht_oper) {
+	if (ht_oper->ht_param & HT_INFO_HT_PARAM_STA_CHNL_WIDTH)
+		return 2;
+	return 1;
+}
+
+/* Return index of the 1 MHz primary within the S1G operating block.
+ * Args:
+ *   s1g_op_chan  : S1G operating channel (block anchor)
+ *   op_bw_mhz    : {1,2,4,8}
+ *   pr_1mhz_chan : candidate 1 MHz primary channel
+ * Returns:
+ *   [0..op_bw_mhz-1] on success, -EINVAL on invalid mapping.
+ *
+ * Generic (non-JP): valid 1 MHz primaries are
+ *   C-(W-1), C-(W-3), ..., C+(W-3), C+(W-1)
+ * For Example for US:
+ *   W=1:               pr = C
+ *   W=2: offsets:      pr = C + {-1, +1}
+ *   W=4: offsets:      pr = C + {-3, -1, +1, +3}
+ *   W=8: offsets:      pr = C + {-7, -5, -3, -1, +1, +3, +5, +7}
+ * with index i = (pr - C + (W-1)) / 2
+ */
+static int calculate_morse_s1g_prim_1mhz_index_default(int s1g_op_chan, int op_bw_mhz, int pr_1mhz_chan)
+{
+    /* Validate op_bw_mhz is one of {1,2,4,8} */
+    if (!(op_bw_mhz == 1 || op_bw_mhz == 2 || op_bw_mhz == 4 || op_bw_mhz == 8))
+        return -EINVAL; /* invalid bandwidth */
+
+    /* Basic arg sanity */
+    if (s1g_op_chan <= 0 || pr_1mhz_chan <= 0)
+        return -EINVAL; /* non-positive channel indices */
+
+    /* Offset from block anchor */
+    int d = pr_1mhz_chan - s1g_op_chan;
+
+    /* Must fall within symmetric range [-(W-1), +(W-1)] */
+    if (d < -(op_bw_mhz - 1) || d > (op_bw_mhz - 1))
+        return -EINVAL; /* outside this W-wide block */
+
+    /* Must step by 2 (…,-3,-1,+1,+3,…) so parity must match */
+    if (((d + (op_bw_mhz - 1)) & 1) != 0)
+        return -EINVAL; /* not an allowed 1 MHz slot inside W */
+
+    /* Map to index 0..W-1 */
+    int idx = (d + (op_bw_mhz - 1)) / 2;
+
+    /* Final range check (defensive) */
+    if (idx < 0 || idx >= op_bw_mhz)
+        return -EINVAL;
+
+    return idx;
+}
+
+/* Japan-specific mapping.
+ * JP allows only pr_1mhz_chan in {9,13,15,17,19,21}.
+ * For 1 MHz: pr == C.
+ * For 2 MHz: pr - C ∈ {11,13} → indices {0,1}.
+ * For 4 MHz: C - pr ∈ {23,21,19,17} → indices {0,1,2,3}.
+ * (No 8 MHz rows in the provided JP data; return -EINVAL for 8.)
+ */
+static int calculate_morse_s1g_prim_1mhz_index_jp(int s1g_op_chan, int op_bw_mhz, int pr_1mhz_chan)
+{
+    /* Validate op_bw_mhz is one of {1,2,4,8} */
+    if (!(op_bw_mhz == 1 || op_bw_mhz == 2 || op_bw_mhz == 4 || op_bw_mhz == 8))
+        return -EINVAL; /* invalid bandwidth */
+
+    /* Basic arg sanity */
+    if (s1g_op_chan <= 0 || pr_1mhz_chan <= 0)
+        return -EINVAL; /* non-positive channel indices */
+
+    /* JP whitelist for 1 MHz primary channels */
+    switch (pr_1mhz_chan) {
+    case 9: case 13: case 15: case 17: case 19: case 21:
+        break; /* allowed */
+    default:
+        return -EINVAL; /* not a valid JP 1 MHz primary */
+    }
+
+    if (op_bw_mhz == 1) {
+        /* For 1 MHz, the primary must equal the operating channel */
+        return (pr_1mhz_chan == s1g_op_chan) ? 0 : -EINVAL;
+    }
+
+    if (op_bw_mhz == 2) {
+        /* JP encodes the two 1 MHz slots as +11 (lower) and +13 (upper) from C */
+        int d = pr_1mhz_chan - s1g_op_chan;
+        if (d == 11) return 0; /* lower 1 MHz slot */
+        if (d == 13) return 1; /* upper 1 MHz slot */
+        return -EINVAL;        /* not a JP 2 MHz slot */
+    }
+
+    if (op_bw_mhz == 4) {
+        /* JP 4 MHz uses fixed negative offsets from C to primaries */
+        int d = s1g_op_chan - pr_1mhz_chan; /* note reversed difference */
+        switch (d) {
+        case 23: return 0; /* pr = C - 23 */
+        case 21: return 1; /* pr = C - 21 */
+        case 19: return 2; /* pr = C - 19 */
+        case 17: return 3; /* pr = C - 17 */
+        default:
+            return -EINVAL; /* not one of the 4 valid JP slots */
+        }
+    }
+
+    /* No 8 MHz mapping present in JP */
+    return -EINVAL;
+}
+
+int morse_s1g_get_prim_1mhz_ch_idx(const char *cc, int s1g_op_chan, int op_bw_mhz, int pr_1mhz_chan)
+{
+    if (cc && os_strncmp(cc, "JP", COUNTRY_CODE_LEN) == 0)
+        return calculate_morse_s1g_prim_1mhz_index_jp(s1g_op_chan, op_bw_mhz, pr_1mhz_chan);
+    return calculate_morse_s1g_prim_1mhz_index_default(s1g_op_chan, op_bw_mhz, pr_1mhz_chan);
+}
+
 #endif /* CONFIG_IEEE80211AH */
diff --git a/src/utils/morse.h b/src/utils/morse.h
index 19b216d83..0648959d1 100644
--- a/src/utils/morse.h
+++ b/src/utils/morse.h
@@ -518,4 +518,68 @@ int morse_raw_priority_enable(const char *ifname, bool enable, u8 prio, u32 star
 bool morse_s1g_is_chan_conf_primary_disabled(struct hostapd_config *conf,
 					     struct hostapd_hw_modes *mode, int s1g_op_chan);
 
+/**
+ * Derive the S1G operating channel from HT/VHT IEs
+ *
+ * Attempts to map HT/VHT operation information elements to an S1G operating
+ * channel. If VHT is present with 80/160 MHz it prefers the VHT centre segment 0
+ * index; otherwise it falls back to the HT primary channel. For JP, applies the
+ * country-specific HT-to-S1G correction before mapping.
+ *
+ * @param cc    Optional two-letter country code (e.g. "US", "JP"); may be NULL
+ * @param ht    Pointer to HT Operation IE; may be NULL if only VHT is available
+ * @param vht   Pointer to VHT Operation IE; may be NULL
+ *
+ * @return S1G operating channel index on success, or -1 if mapping is not possible.
+ */
+int morse_s1g_get_oper_chan_from_ht_vht_ies(char *cc,
+					    struct ieee80211_ht_operation  *ht,
+					    struct ieee80211_vht_operation *vht);
+
+/**
+ * Extract the S1G primary 1 MHz channel from HT IE
+ *
+ * Maps the HT primary channel to its S1G 1 MHz primary channel equivalent.
+ * For JP, applies the country-specific HT offset correction before mapping.
+ *
+ * @param cc        Optional two-letter country code; may be NULL
+ * @param ht_oper   Pointer to HT Operation IE; must not be NULL
+ *
+ * @return S1G primary 1 MHz channel index (may be <= 0 if mapping fails), or -1 on error.
+ */
+int morse_s1g_get_prim_chane_from_ht_ie(char *cc,
+					struct ieee80211_ht_operation *ht_oper);
+
+/**
+ * Determine primary channel width from HT IEs
+ *
+ * Interprets HT operation parameters to infer primary bandwidth. Returns 2 if
+ * the STA channel width flag is set, otherwise 1.
+ *
+ * @param ht_oper   Pointer to HT Operation IE; must not be NULL
+ *
+ * @retval 2  Primary bandwidth implies wider-than-1 MHz (HT 40 semantics).
+ * @retval 1  Primary bandwidth is the narrower setting.
+ */
+int morse_s1g_get_prim_chwidth_from_ht_ies(struct ieee80211_ht_operation *ht_oper);
+
+/**
+ * Compute the 1 MHz primary index (generic/JP)
+ *
+ * Computes the index of the 1 MHz primary within the S1G operating block for
+ * op_bw_mhz ∈ {1,2,4,8}, enforcing valid offset/parity constraints around the
+ * operating channel anchor.
+ *
+ * @param s1g_op_chan   S1G operating channel (block anchor)
+ * @param op_bw_mhz     Operating bandwidth in MHz: {1, 2, 4, 8}
+ * @param pr_1mhz_chan  Candidate 1 MHz primary channel
+ *
+ * @return Index in the range [0 .. op_bw_mhz-1] on success.
+ * @retval -EINVAL  If arguments are invalid or the mapping is not permitted.
+ */
+int morse_s1g_get_prim_1mhz_ch_idx(const char *cc,
+				   int s1g_op_chan,
+				   int op_bw_mhz,
+				   int pr_1mhz_chan);
+
 #endif /* MORSE_H */
