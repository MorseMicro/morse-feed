diff --git a/hostapd/Makefile b/hostapd/Makefile
index 28a67aca3..1a22e1418 100644
--- a/hostapd/Makefile
+++ b/hostapd/Makefile
@@ -180,6 +180,12 @@ OBJS += ../src/common/hw_features_common.o
 
 OBJS += ../src/eapol_auth/eapol_auth_sm.o
 
+ifdef CONFIG_UBUS
+CFLAGS += -DUBUS_SUPPORT
+OBJS += ../src/utils/uloop.o
+OBJS += ../src/ap/ubus.o
+LIBS += -lubox -lubus
