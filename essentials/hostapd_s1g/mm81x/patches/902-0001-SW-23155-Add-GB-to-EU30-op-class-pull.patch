From f4964031853f17c2d5b54e30bf36a70ba1a0bdc0 Mon Sep 17 00:00:00 2001
From: Lewis O'Flynn <lewis.oflynn@morsemicro.com>
Date: Tue, 8 Sep 2026 03:34:41 +0000
Subject: [PATCH] SW-23155 Add GB to EU30 op class (pull request #494)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GB chans 33 and 35 are enabled in the Etna BCF and in the driver.
However they are missing from hostapd’s copy of the op class, so
starting an AP in these channels will fail. Add them.


Approved-by: Sahand Maleki
Approved-by: Andrew Pope
Approved-by: Adam Baumann
Approved-by: Dan Callaghan
---
 src/utils/morse.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/utils/morse.c b/src/utils/morse.c
index 9bef98bef..8c83cf2af 100644
--- a/src/utils/morse.c
+++ b/src/utils/morse.c
@@ -1315,9 +1315,9 @@ static const struct ah_class eu30 = {
 	.s1g_op_class = 30,
 	.global_op_class = 77,
 	.s1g_width = IEEE80211_CHAN_1MHZ,
-	.cc_list = {"AT", "BE", "BG", "FI", "FR", "IS", "IE", "IT", "LT", "MD",
-		    "MK", "PT", "SK", "SI", "SE", "TR", "UG", "CY", "DK", "HU",
-		    "LV", "PL", "ES", "LU"},
+	.cc_list = {"AT", "BE", "BG", "FI", "FR", "GB", "IS", "IE", "IT", "LT",
+		    "MD", "MK", "PT", "SK", "SI", "SE", "TR", "UG", "CY", "DK",
+		    "HU", "LV", "PL", "ES", "LU"},
 	/* Default: full class 77 channel set (channels 31, 33, 35) */
 	.chans = (
 		S1G_CHAN_ENABLED_FLAG(31)|
@@ -1326,7 +1326,7 @@ static const struct ah_class eu30 = {
 	),
 	/* These countries permit only the upper two channels of class 77 */
 	.cc_chan_subset = {
-		.cc_list = {"BG", "FI", "FR", "IT", "TR", "LU"},
+		.cc_list = {"BG", "FI", "FR", "GB", "IT", "TR", "LU"},
 		.chans = (
 			S1G_CHAN_ENABLED_FLAG(33)|
 			S1G_CHAN_ENABLED_FLAG(35)
-- 
2.34.1

