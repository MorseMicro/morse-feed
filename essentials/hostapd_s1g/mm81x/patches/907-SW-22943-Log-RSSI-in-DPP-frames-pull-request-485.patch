From f2c4cf88e657cdc0cef658cad7c3cd2df7eebdfd Mon Sep 17 00:00:00 2001
From: James Haggerty <james.haggerty@morsemicro.com>
Date: Tue, 22 Sep 2026 03:03:02 +0000
Subject: [PATCH 2/5] SW-22943 Log RSSI in DPP frames (pull request #485)

This helps us and customers catch potential DPP issues more easily
(since it's fragile if the signal strength is too high
and if it's too low).


Approved-by: Andrew Pope
Approved-by: Feddrick Aquino
Approved-by: Joshua Wilkinson
---
 src/ap/dpp_hostapd.c            | 18 ++++++++++--------
 src/ap/dpp_hostapd.h            |  3 ++-
 src/ap/drv_callbacks.c          |  3 ++-
 src/ap/ieee802_11.c             |  6 +++---
 wpa_supplicant/dpp_supplicant.c | 19 ++++++++++---------
 wpa_supplicant/dpp_supplicant.h |  2 +-
 wpa_supplicant/events.c         |  2 +-
 7 files changed, 29 insertions(+), 24 deletions(-)

diff --git a/src/ap/dpp_hostapd.c b/src/ap/dpp_hostapd.c
index 00117c890..80e115ed5 100644
--- a/src/ap/dpp_hostapd.c
+++ b/src/ap/dpp_hostapd.c
@@ -3065,7 +3065,8 @@ done:
 
 
 void hostapd_dpp_rx_action(struct hostapd_data *hapd, const u8 *src,
-			   const u8 *buf, size_t len, unsigned int freq)
+			   const u8 *buf, size_t len, unsigned int freq,
+			   int ssi_signal)
 {
 	u8 crypto_suite;
 	enum dpp_public_action_frame_type type;
@@ -3099,25 +3100,26 @@ void hostapd_dpp_rx_action(struct hostapd_data *hapd, const u8 *src,
 
 	wpa_printf(MSG_DEBUG,
 		   "DPP: Received DPP Public Action frame crypto suite %u type %d from "
-		   MACSTR " freq=%u",
-		   crypto_suite, type, MAC2STR(src), freq);
+		   MACSTR " freq=%u rssi=%d",
+		   crypto_suite, type, MAC2STR(src), freq, ssi_signal);
 	if (crypto_suite != 1) {
 		wpa_printf(MSG_DEBUG, "DPP: Unsupported crypto suite %u",
 			   crypto_suite);
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-			" freq=%u type=%d ignore=unsupported-crypto-suite",
-			MAC2STR(src), freq, type);
+			" freq=%u type=%d ignore=unsupported-crypto-suite rssi=%d",
+			MAC2STR(src), freq, type, ssi_signal);
 		return;
 	}
 	wpa_hexdump(MSG_MSGDUMP, "DPP: Received message attributes", buf, len);
 	if (dpp_check_attrs(buf, len) < 0) {
 		wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-			" freq=%u type=%d ignore=invalid-attributes",
-			MAC2STR(src), freq, type);
+			" freq=%u type=%d ignore=invalid-attributes rssi=%d",
+			MAC2STR(src), freq, type, ssi_signal);
 		return;
 	}
 	wpa_msg(hapd->msg_ctx, MSG_INFO, DPP_EVENT_RX "src=" MACSTR
-		" freq=%u type=%d", MAC2STR(src), freq, type);
+		" freq=%u type=%d rssi=%d", MAC2STR(src), freq, type,
+		ssi_signal);
 
 #ifdef CONFIG_DPP2
 	if (dpp_relay_rx_action(hapd->iface->interfaces->dpp,
