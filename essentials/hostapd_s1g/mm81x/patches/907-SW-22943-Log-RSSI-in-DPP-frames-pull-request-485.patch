diff --git a/src/ap/drv_callbacks.c b/src/ap/drv_callbacks.c
index 1f25111f9..692dcccfc 100644
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -1853,7 +1853,8 @@ static void hostapd_action_rx(struct hostapd_data *hapd,
 		pos = mgmt->u.action.u.vs_public_action.oui;
 		end = drv_mgmt->frame + drv_mgmt->frame_len;
 		hostapd_dpp_rx_action(hapd, mgmt->sa, pos, end - pos,
-				      drv_mgmt->freq);
+				      drv_mgmt->freq,
+				      drv_mgmt->ssi_signal);
 		return;
 	}
 #endif /* CONFIG_DPP */
diff --git a/src/ap/ieee802_11.c b/src/ap/ieee802_11.c
index 50d4a7b3b..b9f576dcd 100644
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -6821,7 +6821,7 @@ static int robust_action_frame(u8 category)
 
 static int handle_action(struct hostapd_data *hapd,
 			 const struct ieee80211_mgmt *mgmt, size_t len,
-			 unsigned int freq)
+			 unsigned int freq, int ssi_signal __maybe_unused)
 {
 	struct sta_info *sta;
 	u8 *action __maybe_unused;
@@ -6948,7 +6948,7 @@ static int handle_action(struct hostapd_data *hapd,
 			pos = mgmt->u.action.u.vs_public_action.oui;
 			end = ((const u8 *) mgmt) + len;
 			hostapd_dpp_rx_action(hapd, mgmt->sa, pos, end - pos,
-					      freq);
+					      freq, ssi_signal);
 			return 1;
 		}
 		if (len >= IEEE80211_HDRLEN + 2 &&
@@ -7201,7 +7201,7 @@ int ieee802_11_mgmt(struct hostapd_data *hapd, const u8 *buf, size_t len,
 		break;
 	case WLAN_FC_STYPE_ACTION:
 		wpa_printf(MSG_DEBUG, "mgmt::action");
-		ret = handle_action(hapd, mgmt, len, freq);
+		ret = handle_action(hapd, mgmt, len, freq, ssi_signal);
 		break;
 	default:
 		hostapd_logger(hapd, mgmt->sa, HOSTAPD_MODULE_IEEE80211,
