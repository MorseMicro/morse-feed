+/**
+ * ieee80211_freq_to_display_chan - Convert a frequency into a channel number
+ * for logging/display purposes only (e.g. control interface events).
+ * @freq: Frequency (MHz) to convert
+ * @freq_offset: Frequency offset (kHz), currently unused
+ * @country: Country code, or NULL
+ * Returns: Channel number, or -1 if the frequency could not be mapped
+ */
+int ieee80211_freq_to_display_chan(unsigned int freq, unsigned int freq_offset,
+				   const char *country)
+{
+	u8 channel;
+
+	(void) freq_offset;
+
+	if (!freq)
+		return -1;
+
+#ifdef CONFIG_MORSE_5GHZ_MAPPED
+	{
+		int chan = morse_ht_freq_to_s1g_chan(freq, (char *) country);
+
+		if (chan != MORSE_S1G_RETURN_ERROR)
+			return chan;
+	}
+#endif /* CONFIG_MORSE_5GHZ_MAPPED */
+
+	if (ieee80211_freq_to_chan(freq, &channel) != NUM_HOSTAPD_MODES)
+		return channel;
+
+	return -1;
+}
