#!/usr/bin/ucode -S

/**
 * Used by the Range Testing application for running background commands.
 * 
 * The goal is to eventually move everything into the backend here with 
 * the frontend range testing UI being as dumb as possible. This is an
 * interim solution for the sake of time. The frontend will not have to 
 * do any specific error handling and will only receive a UBUS/RPC code if 
 * errors are encountered.
 * 
 * Background commands create process output files in /var/run/rangetest/<id>.
 * 
 * API Schema:
 *  - background_iperf3_server() => { id }
 *  - background_iperf3_client() => { id, udp, reverse }
 *  - background_iperf3_result( id ) => json_blob
 *  - iw_station_dump() => { interface_1: "...", interface_2: "..." }
 *  - morse_cli_stats_reset() => nothing
 *  - morse_cli_stats() => json_blob
 *  - morse_cli_channel() => json_blob
 *  - ip_link() => { interface_1: {...}, interface_2: {...} }
 *  - info() => { rangetest_api_version: "..." }
 */

import * as ubus from 'ubus';
const fs = require('fs');
const uloop = require('uloop');
const math = require('math');

/**
 * Temporarily defined here and in the uci-defaults script.
 * See the comment in the uci-defaults script for more information.
 */
const API_VERSION="1.0.0";

/* This is weird because running the iperf3 server
 * with -s -1 --json will not produce any output
 * until the end, so assume that no iperf test runs > 5 minutes.
 */
const OUTPUT_DIR_TTL = 300;
const IPERF_OMIT_TIME = 2;
const BG_OUTPUT_DIR = '/var/run/rangetest';

function _get_output_file_paths(id) {
	return {
		stdout: `${BG_OUTPUT_DIR}/${id}/stdout`,
		stderr: `${BG_OUTPUT_DIR}/${id}/stderr`,
		exit_code: `${BG_OUTPUT_DIR}/${id}/exit_code`,
	};
}

/**
 * Prepare an error object to be returned to the frontend.
 * 
 * With the overall intention of making the frontend as dumb as possible,
 * the error message property will be shown blindy to the user if it is present. 
 * Therefore, it should be a user friendly message which is context agnostic,
 * or set to null and excluded from the response.
 * 
 * @param code ubus error code
 * @param message a user facing error messages, excluded if null
 * @param details additional details for developers
 * @returns 
 */
function _error_response(code, message, ...details) {
	const response = {
		error: code,
		details: details
	};

	/* If the message is null, it will be excluded from the response. */
	if (message !== null) {
		response['message'] = message;
	}

	return response;
}

/**
 * Delete a process output directory and all files inside.
 *
 * @param id name of the process output directory in /var/run/rangetest
 * @returns true if success else null if directory inaccesssible
 */
function _delete_output_directory(id) {
	const dir = `${BG_OUTPUT_DIR}/${id}`;
	if (fs.access(dir, 'f') === null) { 
		die(`Unable to access ${dir} (${fs.error()}).`); 
	}
	
	const output_file_paths = _get_output_file_paths(id);
	for (file in output_file_paths) {
		if (fs.unlink(output_file_paths[file]) === null) {
			die(`Unable to delete ${output_file_paths[file]}. (${fs.error()}).`);
		}
	}

	if (fs.rmdir(dir) === null) {
		die(`Unable to delete ${dir} (${fs.error()}).`);
	}
}

/**
 * Delete all the process output directories.
 * 
 * This is predicated on the rangetest only ever being run one at a time
 * and should only be called alongside the `killall -q iperf3` commands.
 */
function _clean_output_directories() {
	if (fs.access(BG_OUTPUT_DIR, 'f') === null) { 
		die(`Unable to access ${BG_OUTPUT_DIR} (${fs.error()}).`); 
	}

	const output_directories = fs.lsdir(BG_OUTPUT_DIR);
	if (output_directories === null) {
		die(`Unable to list directories in ${BG_OUTPUT_DIR} (${fs.error()}).`);
	}

	for (dir in output_directories) { _delete_output_directory(dir); }
}

function _execute_background_command(command) {
	const id = math.rand();

	if (!fs.access(BG_OUTPUT_DIR, 'f')) {
		/* Create the range test output directory if it doesn't exist. */
		if (fs.mkdir(BG_OUTPUT_DIR) === null) {
			die(`Unable to create directory ${BG_OUTPUT_DIR} (${fs.error()}).`);
		}
	}

	/* Create the process output directory. */
	if (fs.mkdir(`${BG_OUTPUT_DIR}/${id}`) === null) { 
		die(`Unable to create directory ${BG_OUTPUT_DIR}/${id} (${fs.error()}).`);
	}

	const output_file_paths = _get_output_file_paths(id);
	for (file in output_file_paths) {
		const n_bytes_written = fs.writefile(output_file_paths[file], null);
		
		/* Empty files return an empty string, not null */
		if (n_bytes_written === null) { 
			die(`Unable to write to file ${output_file_paths[file]} (${fs.error()}).`);
		}
	}

	const stdout_redirect_param = ` 1>${output_file_paths.stdout}`;
	const stderr_redirect_param = ` 2>${output_file_paths.stderr}`;
	command += `${stdout_redirect_param} ${stderr_redirect_param}`;
	const proc = uloop.task((pipe) => {
		/* Has cover-all 10 minute timeout for hanging
		 * iperf3 servers. Since the frontend knows the expected 
		 * time each iperf test will take this timeout could be adjusted
		 * to a more appropriate per-test value in future.
		 */
		const exit_code = system(command, 6000000);
		fs.writefile(output_file_paths.exit_code, exit_code);
	});

	if (!proc) {
		die(`Unable to execute command ${command} (${uloop.error()}).`); 
	}

	return { id: id };
}

function _killall_iperf3() {
	const exit_code = system('killall -q iperf3', 1000);

	/* Returns 1 when there were no processes to kill */ 
	if (exit_code != 0 && exit_code != 1) {
		die(`Exit code: ${exit_code}.`);
	}
}

function background_iperf3_server(req) {
	try { _killall_iperf3(); }
	catch (error) {
		return _error_response(
			ubus.STATUS_SYSTEM_ERROR,
			'Unable to stop existing iPerf3 processes. Please try again. If the problem persists, consider rebooting the device.',
			error
		);
	}

	/* Ignore any errors from cleaning the output directories */
	try {
		_clean_output_directories();
	} catch (error) {}

	try {
		return _execute_background_command('iperf3 -s -1 --json');
	} catch (error) {
		return _error_response(ubus.STATUS_SYSTEM_ERROR, 'Unable to start iPerf3 server. Please try again.', error);
	}
}

function background_iperf3_client(req) {
	const target = req.args.target;
	const udp = req.args.udp ? '-u -b 40M/30' : '-Z';
	const reverse = req.args.reverse ? '-R' : '';
	const time = req.args.time;

	if (time <= IPERF_OMIT_TIME || time >= OUTPUT_DIR_TTL) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, `Invalid time value. Must be between ${IPERF_OMIT_TIME} and ${OUTPUT_DIR_TTL} seconds.`);
	}

	if (iptoarr(target) === null) {
		return _error_response(ubus.STATUS_INVALID_ARGUMENT, 'Invalid target IP address. Please use an IPv4 address.');
	}

	try { _killall_iperf3(); }
	catch (error) {
		return _error_response(
			ubus.STATUS_SYSTEM_ERROR,
			'Unable to stop existing iPerf3 processes. Please try again. If the problem persists, consider rebooting the device.',
			error
		);
	}

	/* Ignore any errors from cleaning the output directories */
	try {
		_clean_output_directories();
	} catch (error) {}
	
	const command = `iperf3 -c ${target} ${udp} ${reverse} -t ${time} -O ${IPERF_OMIT_TIME} --json`;
	try {
		return _execute_background_command(command);
	} catch (error) {
		return _error_response(
			ubus.STATUS_SYSTEM_ERROR,
			'Unable to start iPerf3 client. Please try again.',
			error
		);
	}
}

function get_background(req) {
	const id = req.args.id;

	if (fs.access(`${BG_OUTPUT_DIR}/${id}`, 'f') === null) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'Unable to find iPerf3 test output. Please try again. If the problem persists, consider rebooting the device.',
			`Unable to access ${BG_OUTPUT_DIR}/${id} (${fs.error()})`
		);
	}

	const output_file_paths = _get_output_file_paths(id);
	const output_data = {};

	for (file in output_file_paths) {
		if (fs.access(output_file_paths[file], 'f') === null) {
			return _error_response(
				ubus.STATUS_NOT_FOUND, 
				'Unable to find iPerf3 test output. Please try again. If the problem persists, consider rebooting the device.',
				`Unable to access ${output_file_paths[file]} (${fs.error()})`
			);
		}
		output_data[file] = fs.readfile(output_file_paths[file]);
		if (output_data[file] === null) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to read iPerf3 test output. Please try again. If the problem persists, consider rebooting the device.',
				`Unable to read ${output_file_paths[file]} (${fs.error()})`);
		}
	}

	/* Process is still running */
	if (output_data.exit_code == '') {
		return {};
	}

	if (output_data.exit_code == '0') {
		try {
			return json(output_data.stdout);
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to read iPerf3 test output. Please try again. If the problem persists, consider rebooting the device.',
				`Received invalid JSON (${output_data.stdout}[:100]): ${[substr(output_data.stdout, 0, 100)]}`
			);
		}
	} else {
		return _error_response(
			ubus.STATUS_UNKNOWN_ERROR,
			'Unable to read iPerf3 test output. Please try again. If the problem persists, consider rebooting the device.',
			output_data.stderr
		);
	}
}

function _execute_command(command) {
	let proc = fs.popen(command);
	if (!proc) { die(`Unable to execute the command ${command} (${fs.error()}).`); }

	const output = proc.read('all');
	if (output === null) { die(`Unable to read output from ${command} (${fs.error()}).`); }

	const exit_code = proc.close();
	if (exit_code !== 0) { die(`An error occurred whilst executing the command ${command} (exit code: ${exit_code}).`); }

	return {
		output: output, 
		exit_code: exit_code 
	};
}

/* Determine which network interfaces are morse.
 * 
 * Loop through each interface in /sys/class/net/
 * and check that the driver of the linked PHY device 
 * has a name beginning with "morse". Based on 
 * morse.sh in netifd-morse.
 */
function _get_morse_devices() {
	let morse_devices = [];
	const network_interface_directory = '/sys/class/net/';
	const ls_entries = fs.lsdir(network_interface_directory);
	if (ls_entries === null) { 
		die(`Unable to access ${network_interface_directory} (${fs.error()}).`); 
	}
	
	let device;
	for (device in ls_entries) {
		const driver_path = `/sys/class/net/${device}/phy80211/device/driver`;
		const driver_realpath = fs.readlink(driver_path);
		if (driver_realpath && match(driver_realpath, /\/drivers\/morse_/)) {
			push(morse_devices, device);
		}
	}

	if (morse_devices.length == 0) {
		die('No Morse Micro devices found.');
	} else {
		return morse_devices;
	}
}

function iw_station_dump(req) {
	let output = {};
	let devices, device, results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`iw ${device} station dump`);
			output[device] = results.exit_code == 0 ? results.output : '';
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to collect channel information. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
				error
			);
		}
	}

	return output;
}

function morse_cli_stats_reset(req) {
	let devices, device, results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`morse_cli -i ${device} stats -r`);
			if (results.exit_code == 0) { return {}; }
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to reset Morse Micro chip statistics. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
				error
			);
		}
	}

	return _error_response(ubus.STATUS_NO_DATA, 'No devices were reset.');
}

/**
 * Collect the first valid output of morse_cli stats.
 */
function morse_cli_stats(req) {
	let devices, device, results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`morse_cli -i ${device} stats -j`);
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to collect Morse Micro chip statistics. This may be due to a non-standard HaLow configuration or the chip has malfunctioned. If the problem persists, consider rebooting the device.',
				error
			);
		}
		
		if (results.exit_code == 0) {
			try {
				return json(results.output);
			} catch (error) {
				return _error_response(
					ubus.STATUS_PARSE_ERROR,
					'Unable to collect Morse Micro chip statistics. This may be due to a non-standard HaLow configuration or the chip has malfunctioned. If the problem persists, consider rebooting the device.',
					`Received invalid JSON (${results.output}[:100]): ${[substr(results.output, 0, 100)]}`
				);
			}
		}
	}


	return _error_response(ubus.STATUS_NO_DATA, 'No valid statistics found.');
}

/**
 * Collect the first valid output of morse_cli channel.
 */
function morse_cli_channel(req) {
	let devices, device, results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`morse_cli -i ${device} channel -j`);
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to collect Morse Micro bandwidth information. This may be due to a non-standard HaLow configuration or the chip has malfunctioned. If the problem persists, consider rebooting the device.',
				error
			);
		}

		if (results.exit_code == 0) {
			try {
				return json(results.output);
			} catch (error) {
				return _error_response(
					ubus.STATUS_PARSE_ERROR, 
					'Unable to collect Morse Micro bandwidth information. This may be due to a non-standard HaLow configuration or the chip has malfunctioned. If the problem persists, consider rebooting the device.',
					`Received invalid JSON (${results.output}[:100]): ${[substr(results.output, 0, 100)]}`
				);
			}
		}
	}
}

/**
 * Collect the ip_link output.
 * 
 * This command is run on both the local and remote in order to
 * identify the connected interface for the iwinfo command which
 * is used to collect the channel number.
 */
function ip_link(req) {
	let output = {};
	let devices, device, results, json_results;

	try {
		devices = _get_morse_devices();
	} catch (error) {
		return _error_response(
			ubus.STATUS_NOT_FOUND,
			'No Morse Micro 802.11ah Wi-Fi devices found. Please check that your Morse Micro HaLow Wi-Fi is correctly enabled and configured before trying again.',
			error
		);
	}

	for (device in devices) {
		try {
			results = _execute_command(`ip -j -d link show ${device}`);
		} catch (error) {
			return _error_response(
				ubus.STATUS_SYSTEM_ERROR,
				'Unable to collect channel information. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
				error
			);
		}

		if (results.exit_code == 0) {
			try {
				json_results = json(results.output);
			} catch (error) {
				return _error_response(
					ubus.STATUS_PARSE_ERROR,
					'Unable to collect channel information. This may affect the accuracy of results. If the problem persists, consider rebooting the device.',
					`Received invalid JSON (${results.output}[:100]): ${[substr(results.output, 0, 100)]}`
				);
			}
			
			output[device] = json_results[0];
		} else {
			output[device] = '';
		}
	}
	return output;
}

/**
 * Just the API version for now, but could easily be extended
 * to include information about whether there is an existing
 * rangetest in progress by checking the output directories.
 */
function info(req) {
	return { rangetest_api_version: API_VERSION };
}

