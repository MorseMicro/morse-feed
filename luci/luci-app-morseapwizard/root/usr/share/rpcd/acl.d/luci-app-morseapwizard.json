{
	"luci-app-morseapwizard": {
		"description": "Grant enough access for morseapwizard to rewrite config",
		"read": {
			"ubus": {
				"file": [ "read" ],
				"luci-rpc": ["getBuiltinEthernetPorts"],
				"luci": [ "getTimezones" ]
			},
			"uci": [ "dhcp", "firewall", "network", "wireless", "system", "prplmesh", "mesh11sd", "umdns", "camera-onvif-server" ]
		},
		"write": {
			"ubus": {
				"file": [ "write", "exec" ],
				"luci": [ "setLocaltime" ]
			},
			"uci": [ "dhcp", "firewall", "network", "wireless", "system", "prplmesh", "mesh11sd", "umdns", "camera-onvif-server" ]
		}
	}
}
