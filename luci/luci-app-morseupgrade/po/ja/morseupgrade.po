msgstr "互換性チェックに失敗しました: イメージのメタデータが存在しません。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:232
msgid "Compatibility check failed: incompatible configuration."
msgstr "互換性チェックに失敗しました: 構成が互換性にありません。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:226
msgid "Compatibility check failed: incompatible image version."
msgstr ""
"互換性チェックに失敗しました: イメージのバージョンに互換性がありません。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:207
msgid "Compatibility check failed: invalid image metadata."
msgstr "互換性チェックに失敗しました: イメージのメタデータが無効です。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:455
