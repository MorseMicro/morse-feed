msgid "Previous download in progress..."
msgstr "前回のダウンロードが進行中です…"

#: htdocs/luci-static/resources/view/morse/upgrade.js:553
msgid "Ready to upgrade!"
msgstr "アップグレードの準備ができました!"

#: htdocs/luci-static/resources/view/morse/upgrade.js:731
