msgstr "互換性チェックに失敗しました。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:213
msgid "Compatibility check failed: device mismatch."
msgstr "互換性チェックに失敗しました: デバイスが一致しません。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:200
