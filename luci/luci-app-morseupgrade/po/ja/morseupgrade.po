msgid "File available on MorseMicro image server."
msgstr "MorseMicro イメージサーバーで利用できます。"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:550
msgid "Flash image?"
msgstr "イメージをフラッシュしますか？"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:580
msgid "Flashing…"
msgstr "フラッシュ中…"

#: luci/luci-app-morseupgrade/htdocs/luci-static/resources/view/morse/upgrade.js:519
